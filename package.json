{
  "name": "@inneranimalmedia/agentsam-sdk",
  "version": "2.6.2",
  "description": "Portable AgentSam SDK and CLI kits for local scaffolding, repository intelligence, incremental indexing, identity adapters, and verified dependency maintenance.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./git-context": "./packages/agentsam-repository/src/git-context.js",
    "./bridge-client": "./src/lib/bridge-client.js",
    "./local/sqlite": "./src/local/sqlite.js",
    "./dockerize": "./src/lib/dockerize.js",
    "./mini": "./src/lib/mini/index.js",
    "./merkle": "./packages/agentsam-repository/src/merkle/index.js",
    "./deploy-receipt": "./src/lib/deploy-receipt/index.js",
    "./knowledge": "./src/knowledge/index.js",
    "./knowledge-service-client": "./src/knowledge/service/client.js",
    "./knowledge-service-grpc-client": "./src/knowledge/service/grpc-client.js",
    "./capabilities": "./src/capabilities/index.js",
    "./capability-manifest": "./protocol/capabilities/manifest.json",
    "./repository": "./src/repository/index.js",
    "./repository/contracts": "./packages/agentsam-repository/src/contracts.js",
    "./repository/identity-schema": "./protocol/repository/repository-identity.schema.json",
    "./repository/contract-schema": "./protocol/repository/repository-contract.schema.json",
    "./repository/dependency-schema": "./protocol/repository/repository-dependency.schema.json",
    "./agent": "./src/agent/index.js",
    "./presets": "./src/presets/index.js",
    "./preset-catalog": "./protocol/presets/catalog.json",
    "./identity": "./packages/identity/src/index.js",
    "./identity/providers": "./packages/identity/src/providers/index.js",
    "./identity/providers/google": "./packages/identity/src/providers/google/index.js",
    "./identity/providers/github": "./packages/identity/src/providers/github/index.js",
    "./identity/providers/iam": "./packages/identity/src/providers/iam/index.js",
    "./identity/providers/gcp": "./packages/identity/src/providers/gcp/index.js",
    "./identity/providers/email": "./packages/identity/src/providers/email/index.js",
    "./identity/contracts/identity": "./packages/identity/src/contracts/identity.js",
    "./identity/contracts/session": "./packages/identity/src/contracts/session.js",
    "./identity/contracts/provider": "./packages/identity/src/contracts/provider.js",
    "./identity/contracts/external-identity": "./packages/identity/src/contracts/external-identity.js",
    "./identity/contracts/auth-config": "./packages/identity/src/contracts/auth-config.js",
    "./identity/oauth/callback": "./packages/identity/src/oauth/callback.js",
    "./identity/oauth/finalize-inbound": "./packages/identity/src/oauth/finalize-inbound.js",
    "./identity/oauth/redirect-paths": "./packages/identity/src/oauth/redirect-paths.js",
    "./identity/oauth/credentials": "./packages/identity/src/oauth/credentials.js",
    "./identity/oauth/iam-platform": "./packages/identity/src/oauth/iam-platform.js",
    "./identity/recovery/password-reset": "./packages/identity/src/recovery/password-reset.js",
    "./identity/server/worker-router": "./packages/identity/src/server/worker-router.js",
    "./identity/server/identity-service": "./packages/identity/src/server/identity-service.js",
    "./identity/adapters/cloudflare-d1": "./packages/identity/src/adapters/cloudflare-d1/index.js",
    "./identity/auth-portal/preview": "./packages/identity/scripts/preview-auth-portal.mjs",
    "./package.json": "./package.json",
    "./security": "./src/security/index.js",
    "./cad": "./src/lib/cad/index.js",
    "./cad-docker": "./src/lib/cad-docker.js",
    "./context": "./src/context/index.js",
    "./indexing": "./src/indexing/index.js",
    "./tools": "./src/tools/index.js",
    "./plugins": "./src/plugins/index.js",
    "./models": "./src/models/index.js",
    "./telemetry": "./src/telemetry/index.js",
    "./providers": "./src/providers/index.js",
    "./work-graph": "./packages/work-graph/src/index.js",
    "./work-graph/renderers/timeline": "./packages/work-graph/src/renderers/timeline.js",
    "./work-graph/renderers/gantt-model": "./packages/work-graph/src/renderers/gantt-model.js",
    "./work-graph/adapters/engineering/git": "./packages/work-graph/src/adapters/engineering/git.js",
    "./work-graph/adapters/engineering/mcp": "./packages/work-graph/src/adapters/engineering/mcp.js",
    "./work-graph/adapters/business/projects": "./packages/work-graph/src/adapters/business/projects.js",
    "./errors": "./src/errors/index.js",
    "./errors/schema": "./protocol/errors/error-envelope.schema.json",
    "./errors/catalog": "./protocol/errors/error-catalog.json",
    "./cloudflare": "./src/cloudflare/index.js",
    "./eval": "./src/eval/index.js",
    "./mcp": "./src/mcp/index.js",
    "./context/result-policy-schema": "./protocol/context/result-policy.schema.json",
    "./context/budget-schema": "./protocol/context/context-budget.schema.json",
    "./context/pack-schema": "./protocol/context/resolved-context-pack.schema.json",
    "./skills": "./src/skills/index.js",
    "./skills/catalog": "./skills/catalog.json"
  },
  "bin": {
    "agentsam": "bin/agentsam",
    "agentsam-sdk": "bin/agentsam",
    "agentsam-scaffold": "bin/scaffold.mjs",
    "agentsam-auth-portal": "packages/identity/scripts/preview-auth-portal.mjs"
  },
  "files": [
    "src",
    "packages/identity",
    "packages/agentsam-contracts",
    "packages/agentsam-errors",
    "packages/agentsam-repository",
    "packages/work-graph",
    "packages/connectors/cloudflare",
    "templates",
    "docs",
    "examples",
    "test",
    "python",
    "protocol",
    "migrations",
    "skills",
    "services/knowledge/package.json",
    "services/knowledge/package-lock.json",
    "services/cad/server.py",
    "services/cad/blender",
    "bin",
    "README.md",
    "LICENSE",
    "DEVELOPMENT.md",
    "AGENTSAM.md"
  ],
  "workspaces": [
    "packages/agentsam-shell-kit",
    "packages/identity",
    "packages/agentsam-contracts",
    "packages/agentsam-errors",
    "packages/agentsam-repository",
    "packages/work-graph",
    "packages/agentsam-workbench",
    "packages/agentsam-desktop-shell"
  ],
  "scripts": {
    "test": "npm run test:standard && npm --prefix packages/identity test && npm run test:connectors",
    "test:standard": "node test/smoke.mjs && npm run test:unit && npm run test:cli && npm run test:integration:mock && npm run test:terminal:mock",
    "test:unit": "node --test test/*.test.mjs",
    "test:cli": "node --test test/cli/*.test.mjs",
    "test:integration:mock": "node --test test/integration/*.test.mjs",
    "test:terminal:mock": "node --test test/terminal/*.test.mjs",
    "test:live:terminal": "node --test test/live/*.live.test.mjs",
    "test:identity": "npm --prefix packages/identity test",
    "test:workspaces": "npm --prefix packages/agentsam-contracts test && npm --prefix packages/agentsam-contracts run typecheck && npm --prefix packages/agentsam-errors test && npm --prefix packages/agentsam-repository test && npm --prefix packages/agentsam-workbench test && npm --prefix packages/agentsam-workbench run typecheck && npm --prefix packages/agentsam-shell-kit run typecheck && npm --prefix packages/work-graph test",
    "smoke": "node test/smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:boundaries": "node scripts/verify-source-boundaries.mjs",
    "verify:bootstrap": "node scripts/verify-bootstrap.mjs",
    "verify:knowledge-package": "node scripts/verify-knowledge-package.mjs",
    "test:python": "node scripts/verify-python.mjs",
    "verify:release": "npm run verify && npm run verify:knowledge-package && npm run test:python && npm run security:check",
    "pack:check": "npm pack --dry-run --json",
    "verify": "npm run errors:check && npm run proto:check && npm test && npm run test:workspaces && npm run verify:boundaries && npm run verify:package && npm run verify:bootstrap && npm run pack:check",
    "publish:identity-alpha": "bash scripts/publish-identity-alpha.sh",
    "publish:identity-alpha:dry-run": "bash scripts/publish-identity-alpha.sh --dry-run",
    "publish:identity-alpha:publish-only": "bash scripts/publish-identity-alpha.sh --publish-only",
    "preview:auth-portal": "node packages/identity/scripts/preview-auth-portal.mjs --open",
    "prepublishOnly": "npm run verify:release",
    "security:check": "node src/security/cli.mjs scan",
    "security:repair": "node src/security/cli.mjs repair",
    "ui:preview": "node scripts/ui-preview.mjs",
    "test:connectors": "node --test packages/connectors/cloudflare/tests/**/*.test.mjs",
    "verify:npm10-lock": "node apps/local-studio/scripts/verify-npm10-lock.mjs",
    "proto:generate": "node scripts/generate-proto.mjs",
    "proto:check": "node scripts/verify-proto.mjs",
    "errors:generate": "node scripts/generate-error-contracts.mjs",
    "errors:check": "node scripts/verify-error-contracts.mjs"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@grpc/grpc-js": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-protobuf": "^3.21.4",
    "node-pty": "^1.0.0",
    "pg": "8.16.3",
    "picocolors": "^1.1.1",
    "typescript": "5.9.3",
    "wrangler": "^4.135.0",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SamPrimeaux/agentsam-sdk.git"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "autonomous",
    "mcp",
    "cloudflare",
    "workers"
  ],
  "author": "Sam Primeaux <sam@inneranimalmedia.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SamPrimeaux/agentsam-sdk/issues"
  },
  "homepage": "https://github.com/SamPrimeaux/agentsam-sdk#readme",
  "allowScripts": {
    "node-pty@1.1.0": true,
    "grpc-tools@1.13.1": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "grpc-tools": "^1.13.1"
  },
  "packageManager": "npm@10.9.2"
}
