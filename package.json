{
  "name": "@inneranimalmedia/agentsam-sdk",
  "version": "1.9.0",
  "description": "Agent Sam is a full-stack AI agent SDK for autonomous task execution \u2014 covering data management, creative workflows, design commands, and multi-step agentic pipelines.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentsam": "src/cli.js",
    "agentsam-scaffold": "bin/scaffold.mjs"
  },
  "files": [
    "src",
    "templates",
    "docs",
    "examples",
    "test",
    "python",
    "protocol",
    "bin",
    "README.md",
    "LICENSE",
    "DEVELOPMENT.md"
  ],
  "workspaces": [
    "packages/agentsam-shell-kit",
    "packages/identity"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "node-pty": "^1.0.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SamPrimeaux/agentsam-sdk.git"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "autonomous",
    "mcp",
    "cloudflare",
    "workers"
  ],
  "author": "Sam Primeaux <sam@inneranimalmedia.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SamPrimeaux/agentsam-sdk/issues"
  },
  "homepage": "https://github.com/SamPrimeaux/agentsam-sdk#readme",
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
