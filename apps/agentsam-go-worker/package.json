{
  "name": "@inneranimalmedia/agentsam-go-worker",
  "version": "2.6.10",
  "description": "Deployable AgentSam Go runtime service artifact for Cloudflare Worker + Container self-hosting and official InnerAnimalMedia releases. Independent project; not affiliated with Cloudflare, Inc..",
  "license": "MIT",
  "type": "module",
  "files": [
    "Dockerfile",
    "README.md",
    "agentsam.package.json",
    "contracts",
    "runtime/go.mod",
    "runtime/go.sum",
    "runtime/**/*.go",
    "worker",
    "wrangler.jsonc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "dev": "wrangler dev -c wrangler.jsonc",
    "test:go": "cd runtime && go test ./...",
    "vet:go": "cd runtime && go vet ./...",
    "verify:go": "npm run test:go && npm run vet:go",
    "verify:container": "docker build --platform linux/amd64 -t agentsam-go-worker:verify .",
    "verify:worker": "wrangler deploy -c wrangler.jsonc --dry-run",
    "pack:check": "npm pack --dry-run --json",
    "verify:release": "npm run verify:go && npm run verify:container && npm run verify:worker && npm run pack:check",
    "prepublishOnly": "npm run verify:release"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "wrangler": "4.147.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "apps/agentsam-go-worker"
  }
}
