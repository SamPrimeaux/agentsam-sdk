# Server-side AI provider configuration.
# Set GEMINI_API_KEY in your local environment or deployment secret store.
# Never expose provider keys through frontend code.

# Robotics / embodied-reasoning model policy.
CAD_ROBOTICS_DEFAULT_MODEL=gemini-robotics-er-2-preview
CAD_ROBOTICS_PERCEPTION_MODELS=gemini-robotics-er-2-preview,gemini-flash-latest

# Public application URL when the app needs self-referential links/callbacks.
APP_URL=http://localhost:3000
