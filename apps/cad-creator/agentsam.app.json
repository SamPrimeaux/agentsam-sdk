{
  "schema": "agentsam.app.v1",
  "id": "cad-creator",
  "name": "AgentSam CAD Creator",
  "kind": "app",
  "package": "@inneranimalmedia/agentsam-cad-creator",
  "version": "2.6.13",
  "entrypoints": {
    "frontend": "./frontend",
    "backend": "./backend",
    "cli": "./bin/agentsam-cad-creator.mjs"
  },
  "capabilities": [
    "cad",
    "files",
    "projects",
    "models",
    "robotics"
  ],
  "provides": [
    "workspace.panel",
    "preview",
    "agent.tools"
  ],
  "surfaces": [
    "plan",
    "model",
    "parametric",
    "robotics",
    "render"
  ],
  "auth": {
    "required": true,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    },
    "oauth": {
      "startPattern": "/api/oauth/:provider/start",
      "callbackPattern": "/api/oauth/:provider/callback"
    }
  },
  "routes": {
    "app.authenticated": {
      "path": "/cad",
      "auth": "required",
      "spa": true
    },
    "app.home": {
      "path": "/cad"
    },
    "identity.login": {
      "path": "/auth/login"
    },
    "identity.recovery": {
      "path": "/auth/login"
    },
    "identity.oauth.start": {
      "path": "/api/oauth/:provider/start"
    },
    "identity.oauth.callback": {
      "path": "/api/oauth/:provider/callback"
    },
    "entry": "/cad",
    "mounts": [
      {
        "path": "/cad",
        "auth": "required",
        "spa": true,
        "shell": "dist/index.html"
      }
    ]
  },
  "preview": {
    "kind": "web",
    "bridge": "agentsam.preview.v1",
    "entry": "/",
    "dashboard_route": "/agentsam/apps/cad"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "scaffold",
    "github": "source-ready",
    "native_cad": "discover_on_host",
    "docker_cad": "opt_in_service",
    "hosted_worker_native": "unsupported"
  },
  "commands": {
    "preview": "agentsam-cad-creator",
    "doctor": "agentsam-cad-creator doctor [--json]",
    "scaffold": "agentsam-cad-creator scaffold <directory>",
    "info": "agentsam-cad-creator info",
    "setup": "agentsam-cad-creator setup [--docker]"
  },
  "secrets": {
    "server_only": [
      "GEMINI_API_KEY",
      "MESHY_API_KEY"
    ],
    "note": "Optional provider credentials; native CAD and deterministic robotics do not require an LLM key."
  },
  "bin": "bin/agentsam-cad-creator.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/agentsam-cad-creator",
    "selector": "cad-creator",
    "paths": [
      "/install/cad",
      "/install/cad-creator"
    ]
  },
  "embed": {
    "stage": "cad-creator",
    "build": {
      "cwd": ".",
      "install": {
        "lockfile": "package-lock.json",
        "check": [
          "node_modules/vite/package.json",
          "node_modules/@tailwindcss/vite/package.json"
        ],
        "command": [
          "npm",
          "ci"
        ]
      },
      "command": [
        "npm",
        "run",
        "build",
        "-w",
        "@inneranimalmedia/agentsam-cad-frontend",
        "--",
        "--base={base}"
      ],
      "output": "frontend/dist"
    }
  },
  "storage": {
    "artifactBinding": "WEBSITE_ASSETS",
    "databaseBinding": "DB",
    "objectPrefix": "projects",
    "principal": "oauth_token_verifier",
    "requiredScopes": [
      "cad:artifact.read",
      "cad:artifact.write",
      "cad:artifact.delete",
      "cad:evidence.read",
      "cad:evidence.write",
      "cad:evidence.delete"
    ],
    "limits": {
      "maxArtifactBytes": 26214400
    },
    "evidenceEndpoint": "/api/cad/evidence",
    "bucketName": "cad"
  },
  "theme": {
    "typography": {
      "families": {
        "sans": "AgentSam Sans",
        "display": "AgentSam Sans",
        "mono": "AgentSam Mono"
      },
      "weights": {
        "body": 400,
        "heading": 600,
        "strong": 700
      },
      "sizes": {
        "xs": "10px",
        "sm": "12px",
        "base": "14px",
        "lg": "16px",
        "xl": "18px",
        "h2": "22px",
        "h1": "28px"
      },
      "leading": {
        "tight": 1.2,
        "normal": 1.45,
        "relaxed": 1.65
      },
      "tracking": {
        "tight": "-0.025em",
        "normal": "0",
        "wide": "0.04em"
      },
      "faces": [
        {
          "role": "sans",
          "family": "AgentSam Sans",
          "file": "inter-latin-wght-normal.woff2",
          "weight": "100 900",
          "subset": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
        },
        {
          "role": "mono",
          "family": "AgentSam Mono",
          "file": "jetbrains-mono-latin-wght-normal.woff2",
          "weight": "100 800",
          "subset": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
        }
      ]
    }
  }
}
