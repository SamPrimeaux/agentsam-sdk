{
  "schema": "agentsam.app.v1",
  "id": "cad-creator",
  "name": "AgentSam CAD Creator",
  "kind": "app",
  "package": "@inneranimalmedia/agentsam-cad-creator",
  "version": "2.6.12",
  "entrypoints": {
    "frontend": "./frontend",
    "backend": "./backend",
    "cli": "./bin/agentsam-cad-creator.mjs"
  },
  "capabilities": [
    "cad",
    "files",
    "projects",
    "models",
    "robotics"
  ],
  "provides": [
    "workspace.panel",
    "preview",
    "agent.tools"
  ],
  "surfaces": [
    "plan",
    "model",
    "parametric",
    "robotics",
    "render"
  ],
  "auth": {
    "required": true,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    },
    "oauth": {
      "startPattern": "/api/oauth/:provider/start",
      "callbackPattern": "/api/oauth/:provider/callback"
    }
  },
  "routes": {
    "app.authenticated": {
      "path": "/cad",
      "auth": "required",
      "spa": true
    },
    "app.home": {
      "path": "/cad"
    },
    "identity.login": {
      "path": "/auth/login"
    },
    "identity.recovery": {
      "path": "/auth/login"
    },
    "identity.oauth.start": {
      "path": "/api/oauth/:provider/start"
    },
    "identity.oauth.callback": {
      "path": "/api/oauth/:provider/callback"
    },
    "entry": "/cad",
    "mounts": [
      {
        "path": "/cad",
        "auth": "required",
        "spa": true,
        "shell": "dist/index.html"
      }
    ]
  },
  "preview": {
    "kind": "web",
    "bridge": "agentsam.preview.v1",
    "entry": "/",
    "dashboard_route": "/agentsam/apps/cad"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "scaffold",
    "github": "source-ready",
    "native_cad": "discover_on_host",
    "docker_cad": "opt_in_service",
    "hosted_worker_native": "unsupported"
  },
  "commands": {
    "preview": "agentsam-cad-creator",
    "doctor": "agentsam-cad-creator doctor [--json]",
    "scaffold": "agentsam-cad-creator scaffold <directory>",
    "info": "agentsam-cad-creator info",
    "setup": "agentsam-cad-creator setup [--docker]"
  },
  "secrets": {
    "server_only": [
      "GEMINI_API_KEY",
      "MESHY_API_KEY"
    ],
    "note": "Optional provider credentials; native CAD and deterministic robotics do not require an LLM key."
  },
  "bin": "bin/agentsam-cad-creator.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/agentsam-cad-creator",
    "selector": "cad-creator",
    "paths": [
      "/install/cad",
      "/install/cad-creator"
    ]
  },
  "embed": {
    "stage": "cad-creator",
    "build": {
      "cwd": ".",
      "install": {
        "lockfile": "package-lock.json",
        "check": [
          "node_modules/vite/package.json",
          "node_modules/@tailwindcss/vite/package.json"
        ],
        "command": [
          "npm",
          "ci"
        ]
      },
      "command": [
        "npm",
        "run",
        "build",
        "-w",
        "@inneranimalmedia/agentsam-cad-frontend",
        "--",
        "--base={base}"
      ],
      "output": "frontend/dist"
    }
  }
}
