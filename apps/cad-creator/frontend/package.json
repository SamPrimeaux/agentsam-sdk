{
  "name": "@inneranimalmedia/agentsam-cad-frontend",
  "version": "2.6.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run typography:generate && vite",
    "build": "npm run typography:generate && npm run typography:lint && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typography:generate": "node --experimental-strip-types ../scripts/generate-typography.ts",
    "typography:check": "node --experimental-strip-types ../scripts/generate-typography.ts --check",
    "typography:lint": "node --experimental-strip-types ../scripts/verify-typography.ts && npm run typography:check"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-cad-shared": "2.6.13",
    "@inneranimalmedia/agentsam-workbench": "2.6.13",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mujoco-js": "^0.0.7",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "three": "^0.185.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
