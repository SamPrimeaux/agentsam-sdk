{
  "schema": "agentsam.app.v1",
  "id": "design-canvas",
  "name": "AgentSam Design",
  "kind": "app",
  "package": "@inneranimalmedia/agentsam-design-canvas",
  "version": "0.2.0",
  "entrypoints": {
    "frontend": "./dist",
    "cli": "./bin/agentsam-design-canvas.mjs"
  },
  "capabilities": [
    "design",
    "slides",
    "brand-guidelines",
    "design-systems",
    "artboards",
    "native-editable-objects",
    "comments",
    "source-editing",
    "source-library",
    "local-drafts",
    "editor-layers",
    "presentation-mode",
    "canvas-zoom",
    "canvas-preferences",
    "document-favorites",
    "document-actions",
    "responsive-gallery",
    "document-source-inspector",
    "design-in-code",
    "whiteboard",
    "code-workspace",
    "whiteboard-workspace",
    "page-editor",
    "document-editor",
    "spreadsheet-editor",
    "task-checklists",
    "spreadsheet-formulas",
    "creative-template-browser",
    "shared-creative-artifact-persistence"
  ],
  "provides": [
    "workspace.panel",
    "preview",
    "app.embed",
    "artifact.editor",
    "slides.editor",
    "design-system.editor",
    "artifact.export",
    "document.favorites",
    "presentation.mode",
    "whiteboard.editor",
    "page.editor",
    "document.editor",
    "spreadsheet.editor",
    "creative.templates",
    "artifact.persistence"
  ],
  "surfaces": [
    "desktop",
    "mobile",
    "side-stage",
    "design",
    "slides",
    "design-system",
    "source",
    "code",
    "whiteboard",
    "pages",
    "documents",
    "spreadsheets"
  ],
  "auth": {
    "required": false,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    }
  },
  "routes": {
    "app.home": {
      "path": "/design-canvas"
    },
    "entry": "/design-canvas",
    "mounts": [
      {
        "path": "/design-canvas",
        "spa": true,
        "shell": "dist/index.html"
      }
    ]
  },
  "preview": {
    "kind": "web",
    "bridge": "agentsam.preview.v1",
    "entry": "/"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "not-deployed",
    "hosted_install": "requires-deployment-and-account-install"
  },
  "commands": {
    "preview": "agentsam-design-canvas preview",
    "doctor": "agentsam-design-canvas doctor",
    "info": "agentsam-design-canvas info"
  },
  "bin": "./bin/agentsam-design-canvas.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/agentsam-design-canvas",
    "selector": "design-canvas"
  },
  "embed": {
    "stage": "design-canvas",
    "build": {
      "cwd": ".",
      "command": [
        "node",
        "scripts/build.mjs"
      ],
      "output": "dist",
      "index": "index.html"
    }
  },
  "product_id": "design-canvas",
  "distribution": {
    "kind": "app",
    "release_status": "source-release-verified-only"
  },
  "screens": [
    {
      "id": "canvas.editor",
      "app_id": "design-canvas",
      "route": "/admin/canvas",
      "primary": true,
      "module": "routes/(apps)/admin/canvas.tsx",
      "export": "CanvasPage",
      "mount": {
        "type": "host-component",
        "scope": "host"
      },
      "navigation": {
        "surface": "admin-nav",
        "label": "Design",
        "icon": "palette",
        "primary": true,
        "key": "design-canvas"
      }
    }
  ],
  "description": "Creative workspace for Pages, Documents, Spreadsheets, presentations, visual design, reusable design systems and whiteboarding, with native editable artifacts and a direct handoff to AgentSam Work for code implementation."
}
