{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inneranimalmedia.com/schemas/theme-package-contract.v1.json",
  "title": "InnerAnimalMedia Theme Package Contract v1",
  "type": "object",
  "required": ["contractVersion", "id", "name", "layouts", "templates", "sections", "components"],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "layouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutDefinition" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateDefinition" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/sectionDefinition" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/componentDefinition" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["key", "label", "type"],
      "additionalProperties": true,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["text", "rich_text", "textarea", "boolean", "select", "range", "number", "color", "link", "media", "video", "product", "collection", "variant"]
        },
        "group": { "type": "string" },
        "default": {}
      }
    },
    "blockDefinition": {
      "type": "object",
      "required": ["type", "label", "fields"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "repeatable": { "type": "boolean", "default": true },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "sectionDefinition": {
      "type": "object",
      "required": ["type", "label", "renderer", "fields", "blocks", "presets"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "renderer": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockDefinition" }
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": true,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "defaults": { "type": "object" }
            }
          }
        }
      }
    },
    "templateDefinition": {
      "type": "object",
      "required": ["id", "layout", "allowedSectionTypes"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pageType": { "type": "string" },
        "layout": { "type": "string", "minLength": 1 },
        "allowedSectionTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "defaultSections": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "layoutDefinition": {
      "type": "object",
      "required": ["id", "regions"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "object",
          "required": ["header", "main", "footer"],
          "properties": {
            "header": { "type": "object" },
            "main": { "type": "object" },
            "footer": { "type": "object" }
          }
        }
      }
    },
    "componentDefinition": {
      "type": "object",
      "required": ["id", "renderer"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "renderer": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "slots": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
