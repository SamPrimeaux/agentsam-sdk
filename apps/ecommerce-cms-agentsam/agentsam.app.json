{
  "schema": "agentsam.app.v1",
  "id": "ecommerce-cms-agentsam",
  "name": "AgentSam Ecommerce + CMS",
  "version": "2.6.11",
  "bin": "bin/agentsam-ecommerce.mjs",
  "commands": {
    "info": "agentsam-ecommerce info",
    "doctor": "agentsam-ecommerce doctor",
    "preview": "agentsam-ecommerce preview",
    "scaffold": "agentsam-ecommerce scaffold <directory>"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "requires-owner-provisioning"
  },
  "capabilities": {
    "products": true,
    "cms": true,
    "media": true,
    "catalog": true,
    "annotation": true,
    "fulfillment_automation": false,
    "pages": true,
    "theme_editor": true,
    "preview": true,
    "publish": true,
    "routes": true,
    "groups": true,
    "sections": true,
    "blocks": true,
    "composition_revisions": true
  },
  "modes": [
    "standalone",
    "embedded"
  ],
  "features": [
    "admin.shell-nav",
    "agentsam.mini-composer",
    "commerce.product-studio",
    "growth.campaigns",
    "provider.completeful",
    "provider.resend"
  ],
  "notes": "Portable AgentSam Ecommerce + CMS application. Authoring is group/section/block-first; routes/pages are containers. Customer identity, content, providers, and credentials remain installation-owned.",
  "kind": "app",
  "package": "@inneranimalmedia/ecommerce-cms-agentsam",
  "preview": {
    "kind": "web",
    "bridge": "agentsam.preview.v1",
    "entry": "/admin",
    "port": 4174
  }
}
