{
  "schema": "agentsam.app.v1",
  "id": "ecommerce-cms-agentsam",
  "name": "AgentSam Ecommerce + CMS",
  "version": "0.2.0",
  "bin": "bin/agentsam-ecommerce.mjs",
  "commands": {
    "info": "agentsam-ecommerce info",
    "doctor": "agentsam-ecommerce doctor",
    "preview": "agentsam-ecommerce preview",
    "scaffold": "agentsam-ecommerce scaffold <directory>"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "requires-owner-provisioning"
  },
  "capabilities": {
    "products": true,
    "cms": true,
    "media": true,
    "catalog": true,
    "annotation": true,
    "fulfillment_automation": false
  },
  "modes": [
    "standalone",
    "embedded"
  ],
  "features": [
    "admin.shell-nav",
    "agentsam.mini-composer",
    "commerce.product-studio",
    "growth.campaigns",
    "provider.completeful",
    "provider.resend"
  ],
  "notes": "Fuel & Free Time reference installation. Feature capsules under ../../features/*. App contract twin: .agentsam/app.json",
  "kind": "app",
  "package": "@inneranimalmedia/ecommerce-cms-agentsam",
  "preview": {
    "kind": "web",
    "bridge": "agentsam.preview.v1",
    "entry": "/admin",
    "port": 4174
  }
}
