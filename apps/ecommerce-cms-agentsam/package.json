{
  "name": "@inneranimalmedia/ecommerce-cms-agentsam",
  "version": "2.6.13",
  "description": "Installable AgentSam ecommerce and website CMS application with product and inventory management, theme editing, media, analytics, and provider integrations.",
  "private": false,
  "type": "module",
  "bin": {
    "ecommerce": "bin/ecommerce.mjs",
    "assets": "bin/assets.mjs",
    "agentsam-ecommerce": "bin/ecommerce.mjs"
  },
  "scripts": {
    "doctor": "node bin/ecommerce.mjs doctor",
    "preview": "node bin/ecommerce.mjs preview",
    "build:frontend": "npm run build --prefix frontend",
    "build:assets": "node bin/build-assets.mjs",
    "build": "npm run verify:cms && npm run build:frontend && npm run build:assets",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:package": "node --test tests/package-boundaries.test.mjs && npm run test:tools",
    "typecheck:cms": "tsc --project tsconfig.cms.json",
    "verify:cms": "npm run typecheck:cms && node --test tests/cms-setting-contract.test.mjs",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "test:tools": "npm run typecheck:tools && node --test tests/typed-tool-registry.test.mjs tests/core-tools-readonly.test.mjs tests/d1-crud.test.mjs && node backend/tools/doctor.mjs",
    "test:release": "node --test tests/release-artifact.test.mjs tests/analytics-hosts.test.mjs tests/side-assistant-portability.test.mjs tests/newsletter-lifecycle.test.mjs",
    "prepack": "npm run build && npm run test:release",
    "install:studio": "node scripts/install-studio-deps.mjs",
    "release:verify": "npm run build && npm run test:package && npm run test:release"
  },
  "dependencies": {
    "@inneranimalmedia/revise-theme": "0.2.0",
    "@inneranimalmedia/section-library": "0.1.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.149.0",
    "typescript": "~6.0.2",
    "json-schema-to-ts": "3.1.1"
  },
  "files": [
    ".agentsam/app.json",
    "AGENTS.md",
    "README.md",
    "agentsam.app.json",
    "npm-shrinkwrap.json",
    "apps/",
    "backend/",
    "bin/",
    "cms/",
    "db/",
    "dist/",
    "docs/",
    "frontend/",
    "packages/",
    "registry/",
    "scripts/install-studio-deps.mjs",
    "scripts/sync-theme-embed-catalog.mjs",
    "scripts/verify-cms-product.mjs",
    "shared/",
    "templates/",
    "tests/",
    "theme/",
    "repository.contracts.json",
    "tsconfig.cms.json",
    "tsconfig.tools.json"
  ],
  "exports": {
    "./manifest": "./agentsam.app.json",
    "./cms": {
      "types": "./frontend/cms/index.d.ts",
      "import": "./frontend/cms/index.mjs"
    },
    "./cms/capabilities": {
      "types": "./frontend/cms/capabilities.d.ts",
      "import": "./frontend/cms/capabilities.mjs"
    },
    "./admin/surface": "./frontend/admin.surface.json",
    "./apps/registry": "./apps/registry.json",
    "./backend/routes": "./backend/lib/route-manifest.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "apps/ecommerce-cms-agentsam"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
