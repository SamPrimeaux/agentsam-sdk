{
  "name": "@inneranimalmedia/ecommerce-cms-agentsam",
  "version": "2.6.9",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test test/*.test.mjs && npm run test --workspaces --if-present",
    "clean": "rm -rf frontend/dist",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "apps/ecommerce-cms-agentsam"
  },
  "bin": {
    "agentsam-ecommerce": "bin/agentsam-ecommerce.mjs"
  },
  "files": [
    "bin/",
    "agentsam.app.json",
    "IMPORT_PROVENANCE.json",
    "docs/",
    "providers/",
    "frontend/",
    "README.md",
    "AGENTS.md",
    "reference/",
    "test/"
  ],
  "description": "Productized AgentSam ecommerce + CMS application: public storefront, OAuth-gated admin, theme/page editing, media and product workflows, analytics, provider adapters, and Cloudflare deployment surfaces.",
  "license": "UNLICENSED"
}
