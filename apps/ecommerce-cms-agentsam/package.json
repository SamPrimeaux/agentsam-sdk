{
  "name": "@inneranimalmedia/ecommerce-cms-agentsam",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ecommerce": "bin/ecommerce.mjs",
    "assets": "bin/assets.mjs"
  },
  "scripts": {
    "doctor": "node bin/ecommerce.mjs doctor",
    "preview": "node bin/ecommerce.mjs preview",
    "build:frontend": "npm run build --prefix frontend",
    "build:assets": "node bin/build-assets.mjs",
    "build": "npm run verify:cms && npm run build:frontend && npm run build:assets",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:package": "node --test tests/package-boundaries.test.mjs && npm run test:tools",
    "typecheck:cms": "tsc --project tsconfig.cms.json",
    "verify:cms": "npm run typecheck:cms && node --test tests/cms-setting-contract.test.mjs",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "test:tools": "npm run typecheck:tools && node --test tests/typed-tool-registry.test.mjs tests/core-tools-readonly.test.mjs tests/d1-crud.test.mjs && node backend/tools/doctor.mjs"
  },
  "dependencies": {
    "@inneranimalmedia/revise-theme": "0.2.0",
    "@inneranimalmedia/section-library": "0.1.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.149.0",
    "typescript": "~6.0.2",
    "json-schema-to-ts": "3.1.1"
  }
}
