{
  "schema": "agentsam.package.v1",
  "id": "samspeaks",
  "name": "SamSpeaks",
  "kind": "module",
  "package": "@inneranimalmedia/samspeaks",
  "version": "0.1.0",
  "entrypoints": {
    "frontend": "./",
    "backend": "./server.ts"
  },
  "capabilities": [
    "voice-direction",
    "scene-direction",
    "creativity-flow",
    "tts"
  ],
  "provides": [
    "workspace.panel",
    "preview",
    "scene.authoring"
  ],
  "surfaces": [
    "inspo",
    "compose",
    "stage",
    "direct",
    "flow-canvas",
    "lighting"
  ],
  "auth": {
    "required": false,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    }
  },
  "routes": {
    "app.authenticated": {
      "path": "/samspeaks",
      "auth": "optional",
      "spa": true
    },
    "app.home": {
      "path": "/samspeaks"
    },
    "entry": "/samspeaks",
    "mounts": [
      {
        "path": "/samspeaks",
        "auth": "optional",
        "spa": true,
        "shell": "dist/index.html"
      }
    ]
  },
  "preview": {
    "kind": "web",
    "entry": "/",
    "dashboard_route": "/samspeaks"
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "scaffold",
    "type": "spa",
    "assetRoot": "dist",
    "shell": "index.html"
  },
  "secrets": {
    "server_only": [
      "GEMINI_API_KEY"
    ]
  },
  "embed": {
    "stage": "samspeaks",
    "build": {
      "cwd": ".",
      "install": {
        "lockfile": "package-lock.json",
        "check": [
          "node_modules/vite/package.json",
          "node_modules/xrblocks/package.json",
          "node_modules/@inneranimalmedia/agentsam-3d-viewer/package.json"
        ],
        "command": [
          "npm",
          "ci",
          "--ignore-scripts",
          "--no-audit",
          "--no-fund"
        ]
      },
      "command": [
        "npm",
        "run",
        "build",
        "--",
        "--base={base}"
      ],
      "output": "dist"
    }
  },
  "type": "module",
  "owner_app_id": "moviemode",
  "installable": false,
  "role": "moviemode-voice-direction",
  "description": "Portable SamSpeaks audio and voice-direction module owned by MovieMode; can be reused by another authorized host."
}
