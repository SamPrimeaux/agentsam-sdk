{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./frontend/src/*"
      ],
      "@inneranimalmedia/agentsam-ide/workspace": ["../../packages/agentsam-ide/src/workspace/index.ts"],
      "@inneranimalmedia/agentsam-ide/surface": ["../../packages/agentsam-ide/src/surface/index.ts"],
      "@inneranimalmedia/agentsam-ide/surface/workspace-editor.css": ["../../packages/agentsam-ide/src/surface/workspace-editor.css"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "frontend/src",
    "backend/server",
    "shared/agentsam/src"
  ]
}
