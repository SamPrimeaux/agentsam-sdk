{
  "schema": "agentsam.app.v1",
  "id": "local-studio",
  "name": "AgentSam Local Studio",
  "kind": "app",
  "package": "@inneranimalmedia/agentsam-local-studio",
  "version": "2.6.10",
  "entrypoints": {
    "frontend": "./frontend",
    "backend": "./backend",
    "cli": "./bin/agentsam-studio.mjs"
  },
  "capabilities": [
    "host",
    "workbench",
    "auth",
    "vault",
    "ship",
    "compose.apps"
  ],
  "provides": [
    "host.mount",
    "workspace.shell",
    "preview",
    "agent.tools"
  ],
  "surfaces": [
    "workbench",
    "work",
    "auth-portal",
    "vault",
    "ship",
    "cli-drawer"
  ],
  "auth": {
    "required": false,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    },
    "oauth": {
      "startPattern": "/api/oauth/:provider/start",
      "callbackPattern": "/api/oauth/:provider/callback",
      "connections": {
        "cloudflare": {
          "start": "/api/connections/cloudflare/start",
          "callback": "/api/connections/cloudflare/callback"
        }
      }
    }
  },
  "routes": {
    "app.authenticated": {
      "path": "/agentsam",
      "auth": "optional",
      "spa": true
    },
    "app.home": {
      "path": "/agentsam"
    },
    "identity.login": {
      "path": "/auth/login"
    },
    "identity.signup": {
      "path": "/auth/signup"
    },
    "identity.reset": {
      "path": "/auth/reset"
    },
    "identity.recovery": {
      "path": "/auth/login"
    },
    "identity.oauth.start": {
      "path": "/api/oauth/:provider/start"
    },
    "identity.oauth.callback": {
      "path": "/api/oauth/:provider/callback"
    },
    "entry": "/agentsam",
    "mounts": [
      {
        "path": "/agentsam",
        "auth": "optional",
        "spa": true,
        "shell": "dist/index.html"
      },
      {
        "path": "/collaborate",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/mail",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/projects",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/artifacts",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/files",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/browse",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/cli",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/ship",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/cad",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/cms",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/database",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/settings",
        "auth": "optional",
        "spa": true
      },
      {
        "path": "/settings/themes",
        "auth": "optional",
        "spa": true
      }
    ]
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "ready",
    "github": "source-ready",
    "type": "spa",
    "assetRoot": "dist",
    "shell": "index.html"
  },
  "commands": {
    "preview": "agentsam-studio",
    "info": "agentsam-studio info",
    "doctor": "agentsam-studio doctor"
  },
  "bin": "bin/agentsam-studio.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/agentsam-local-studio",
    "selector": "local-studio",
    "paths": [
      "/install/studio",
      "/install/local-studio"
    ]
  },
  "secrets": {
    "platform_server": [
      "VAULT_MASTER_KEY",
      "AGENTSAM_BRIDGE_KEY",
      "CLOUDFLARE_OAUTH_CLIENT_ID"
    ],
    "user_credentials": [
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "ANTHROPIC_API_KEY",
      "XAI_API_KEY",
      "CURSOR_API_KEY",
      "AGENTSAM_API_KEY"
    ]
  }
}
