{
  "schema": "agentsam.app.v1",
  "id": "local-studio",
  "name": "AgentSam Local Studio",
  "kind": "app",
  "package": "@inneranimalmedia/agentsam-local-studio",
  "version": "0.0.0",
  "entrypoints": {
    "frontend": "./frontend",
    "backend": "./backend",
    "cli": "./bin/agentsam-studio.mjs"
  },
  "capabilities": [
    "host",
    "workbench",
    "auth",
    "vault",
    "ship",
    "compose.apps"
  ],
  "provides": [
    "host.mount",
    "workspace.shell",
    "preview",
    "agent.tools"
  ],
  "surfaces": [
    "workbench",
    "auth-portal",
    "vault",
    "ship",
    "cli-drawer"
  ],
  "auth": {
    "required": true,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    },
    "oauth": {
      "startPattern": "/api/oauth/:provider/start",
      "callbackPattern": "/api/oauth/:provider/callback",
      "connections": {
        "cloudflare": {
          "start": "/api/connections/cloudflare/start",
          "callback": "/api/connections/cloudflare/callback"
        }
      }
    }
  },
  "hosts": [
    {
      "host_id": "local-studio-public",
      "origin": "https://agentsam.inneranimalmedia.com",
      "role": "production",
      "notes": "HOST namespace for this APP — Cloudflare/Google OAuth clients and connection authorize URLs. Not IAM_OAUTH_ISSUER (PLATFORM account API)."
    },
    {
      "host_id": "local-studio-loopback",
      "origin": "http://localhost:3000",
      "role": "development"
    }
  ],
  "routes": {
    "app.authenticated": { "path": "/agentsam", "auth": "required", "spa": true },
    "app.home": { "path": "/agentsam" },
    "identity.login": { "path": "/auth/login" },
    "identity.signup": { "path": "/auth/signup" },
    "identity.reset": { "path": "/auth/reset" },
    "identity.recovery": { "path": "/auth/login" },
    "identity.oauth.start": { "path": "/api/oauth/:provider/start" },
    "identity.oauth.callback": { "path": "/api/oauth/:provider/callback" },
    "entry": "/agentsam",
    "mounts": [
      { "path": "/agentsam", "auth": "required", "spa": true, "shell": "dist/index.html" },
      { "path": "/projects", "auth": "required", "spa": true },
      { "path": "/artifacts", "auth": "required", "spa": true },
      { "path": "/files", "auth": "required", "spa": true },
      { "path": "/browse", "auth": "required", "spa": true },
      { "path": "/cli", "auth": "required", "spa": true },
      { "path": "/ship", "auth": "required", "spa": true },
      { "path": "/cad", "auth": "required", "spa": true },
      { "path": "/cms", "auth": "required", "spa": true },
      { "path": "/database", "auth": "required", "spa": true },
      { "path": "/settings", "auth": "required", "spa": true },
      { "path": "/settings/themes", "auth": "required", "spa": true }
    ]
  },
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "ready",
    "github": "source-ready",
    "type": "spa",
    "assetRoot": "dist",
    "shell": "index.html"
  },
  "commands": {
    "preview": "agentsam-studio",
    "info": "agentsam-studio info",
    "doctor": "agentsam-studio doctor"
  },
  "bin": "bin/agentsam-studio.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/agentsam-local-studio",
    "selector": "local-studio",
    "paths": ["/install/studio", "/install/local-studio"]
  },
  "secrets": {
    "platform_server": [
      "VAULT_MASTER_KEY",
      "AGENTSAM_BRIDGE_KEY",
      "IAM_CLIENT_ID",
      "IAM_CLIENT_SECRET",
      "IAM_OAUTH_ISSUER",
      "CLOUDFLARE_OAUTH_CLIENT_ID"
    ],
    "user_credentials": [
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "ANTHROPIC_API_KEY",
      "XAI_API_KEY",
      "CURSOR_API_KEY",
      "AGENTSAM_API_KEY"
    ]
  }
}
