# Copy to .env.cloudflare (gitignored). Wrangler + agentsam CLI read this.
# Do not put API tokens in git.

CLOUDFLARE_ACCOUNT_ID=ede6590ac0d2fb7daf155b35653457b2
CLOUDFLARE_ACCOUNT_NAME="Inner Animal Media"

# Vault Worker
WORKMODE_APP=agentsam-workmode
D1_DATABASE_NAME=inneranimalmedia-business
D1_DATABASE_ID=cf87b717-d4e2-4cf8-bab0-a81268e32d49

# UI Worker owns /*
UI_WORKER=agentsam-grok-workmode
PRODUCT_HOST=simple.inneranimalmedia.com
ZONE_NAME=inneranimalmedia.com

# Local Ollama via existing iMac tunnel (no model on the edge)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Fill locally — never commit
# CLOUDFLARE_API_TOKEN=
# OLLAMA_TOKEN=
