# Optional local Cloudflare operator/provisioning identity.
# Copy to .env.cloudflare (gitignored). Never ship to the browser.
# This file is bootstrap input only — not the deployed secret store.

CLOUDFLARE_ACCOUNT_ID=

# Optional local operator token used only for provisioning/admin operations.
# Do not copy into application frontend/runtime.
CLOUDFLARE_API_TOKEN=

# Dedicated Cloudflare OAuth application belonging to THIS app.
# Fixture values prove scaffold/build only. They are never production authority.
CLOUDFLARE_OAUTH_CLIENT_ID=sillynotreal
CLOUDFLARE_OAUTH_CLIENT_SECRET=sillynotreal-secret

# IAM identity (separate from the Cloudflare connector).
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_OAUTH_ISSUER=https://inneranimalmedia.com
# IAM_ORIGIN is a deprecated alias of IAM_OAUTH_ISSUER.
