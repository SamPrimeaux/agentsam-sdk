{
  "schema": "agentsam.package.v1",
  "name": "agentsamd",
  "type": "daemon",
  "runtime": "go",
  "version": "0.1.0",
  "targets": [
    "darwin-arm64",
    "darwin-amd64",
    "linux-amd64",
    "linux-arm64"
  ],
  "entrypoints": {
    "daemon": "../agentsam-go-worker/runtime/cmd/agentsamd"
  },
  "capabilities": [
    "health",
    "runtime",
    "capabilities",
    "hash",
    "inspect",
    "enroll",
    "terminal.exec.local",
    "mcp.client",
    "cloudflare.oauth",
    "cloudflare.mcp_portals"
  ],
  "protocol": "agentsam.runtime.v1",
  "runtime_adapter": "agentsamd",
  "product": {
    "slug": "agentsamd",
    "kind": "daemon",
    "distinct_from": "agentsam-go-worker",
    "role": "local-machine-runtime"
  },
  "cloudflare": {
    "permission_registry": {
      "provider_plugin": "agentsam-mcp",
      "source": "agentsam_plugins.config_json.oauth_permissions",
      "host_adapter": "apps/local-studio/backend/worker/cloudflare-plugin-permission-registry.js",
      "connector_contract": "packages/connectors/cfoa/src/PERMISSION_REGISTRY.md"
    },
    "mcp_portals": {
      "manage_capability": "cloudflare.mcp_portals",
      "bundles": "src/mcp/cloudflare-bundles.js",
      "connections": "apps/local-studio/backend/worker/index.js"
    }
  },
  "mcp": {
    "authority": "~/.agentsam/mcp/",
    "clients": [
      "cursor",
      "claude",
      "chatgpt",
      "agentsam"
    ],
    "offerable_server_connections": true
  },
  "distribution": {
    "install": "agentsam runtime install",
    "setup": "agentsam setup runtime --profile my_computer --yes",
    "launch_agent": "com.inneranimalmedia.agentsamd",
    "bin_dir": "~/.agentsam/bin"
  }
}
