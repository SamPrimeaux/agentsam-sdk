{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@inneranimalmedia/agentsam-cms-shared": ["../shared/cms/src/index.ts"],
      "@inneranimalmedia/agentsam-cms-shared/*": ["../shared/cms/src/*"]
    }
  },
  "include": ["src"]
}
