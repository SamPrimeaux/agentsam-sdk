{
  "name": "@inneranimalmedia/agentsam-cms-backend",
  "version": "2.6.11",
  "description": "Internal CMS backend bridge (bundled into @inneranimalmedia/client-cms-editor — not published separately).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/client.ts",
    "./model": "./src/model.ts",
    "./preview": "./src/preview/bridge.ts",
    "./routing": "./src/routing/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-cms-shared": "2.6.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "apps/client-cms-editor/backend"
  },
  "files": [
    "src"
  ],
  "agentsam": {
    "releaseIgnore": [
      "worker",
      "wrangler.jsonc"
    ]
  },
  "private": true
}
