{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "@inneranimalmedia/agentsam-cms-shared": ["../shared/cms/src/index.ts"],
      "@inneranimalmedia/agentsam-cms-shared/*": ["../shared/cms/src/*"],
      "@inneranimalmedia/agentsam-cms-backend/api": ["../backend/src/api/client.ts"],
      "@inneranimalmedia/agentsam-cms-backend/model": ["../backend/src/model.ts"],
      "@inneranimalmedia/agentsam-cms-backend/preview": ["../backend/src/preview/bridge.ts"],
      "@inneranimalmedia/agentsam-cms-backend/routing": ["../backend/src/routing/index.js"],
      "@inneranimalmedia/agentsam-cms-backend": ["../backend/src/index.ts"],
      "@inneranimalmedia/agentsam-cms-backend/*": ["../backend/src/*"]
    }
  },
  "include": [
    "src"
  ]
}
