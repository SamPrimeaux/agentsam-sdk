{
  "schema": "agentsam.app.v1",
  "id": "client-cms-editor",
  "product_id": "cms",
  "name": "AgentSam CMS Editor",
  "kind": "app",
  "package": "@inneranimalmedia/client-cms-editor",
  "version": "0.1.0",
  "entrypoints": {
    "frontend": "./frontend",
    "backend": "./backend",
    "cli": "./bin/agentsam-cms.mjs"
  },
  "capabilities": [
    "cms",
    "media",
    "templates",
    "admin_content"
  ],
  "provides": [
    "cms.editor",
    "cms.templates",
    "cms.media.library",
    "workspace.panel"
  ],
  "surfaces": [
    "store",
    "theme-editor",
    "cms-editor",
    "templates",
    "media-library",
    "agentsam"
  ],
  "runtime": {
    "local_preview": "ready",
    "source_scaffold": "ready",
    "cloudflare": "ready",
    "github": "source-ready",
    "browser": true,
    "local": true
  },
  "commands": {
    "preview": "agentsam-cms",
    "doctor": "agentsam-cms doctor",
    "scaffold": "agentsam-cms scaffold <directory>",
    "info": "agentsam-cms info"
  },
  "bin": "bin/agentsam-cms.mjs",
  "install": {
    "command": "npm install @inneranimalmedia/client-cms-editor",
    "selector": "client-cms-editor",
    "paths": ["/install/cms", "/install/client-cms-editor"]
  }
}
