{
  "name": "@inneranimalmedia/financial-analytics",
  "version": "2.6.14",
  "description": "Provider-neutral financial analytics contracts and adaptive presentation for merchant, SaaS, and service businesses.",
  "type": "module",
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/provider-connect": {
      "types": "./dist/ui/provider-connect-flow.d.ts",
      "import": "./dist/ui/provider-connect-flow.js"
    },
    "./ui/cms-billing-portal": {
      "types": "./dist/ui/cms-billing-portal-embed.d.ts",
      "import": "./dist/ui/cms-billing-portal-embed.js"
    },
    "./styles/cms-billing-embed.css": "./styles/cms-billing-embed.css",
    "./styles/provider-connect.css": "./styles/provider-connect.css"
  },
  "dependencies": {
    "@inneranimalmedia/analytics-ui": "2.6.14"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "license": "FSL-1.1-MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/financial-analytics"
  }
}
