{
  "name": "@inneranimalmedia/primetech-procedures",
  "version": "2.6.20",
  "type": "module",
  "description": "PrimeTech creative-production procedures, portable AgentSam/OpenAI skills, deterministic asset builders, approval-aware execution and evidence receipts.",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./skills": {
      "types": "./src/skills.d.ts",
      "import": "./src/skills.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "generate:skills": "python3 scripts/generate-skills.py",
    "generate:procedures": "python3 scripts/generate-procedures.py",
    "prepack": "npm test"
  },
  "files": [
    "plugin.README.md",
    "companion.json",
    "assets/",
    ".codex-plugin/",
    "agents/",
    "plugin.json",
    "agentsam.package.json",
    "src/",
    "procedures/",
    "profiles/",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "FSL-1.1-MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/primetech-procedures"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5"
  },
  "types": "./src/index.d.ts"
}
