{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "primetech.production-board.manage",
  "version": "1.0.0",
  "summary": "Manage a revisioned creative production board and resumable generation receipts.",
  "effect": "project_write",
  "capabilities": [
    "primetech.production-board.manage"
  ],
  "runtime": {
    "kind": "sam_operation",
    "operation": "primetech.production-board.manage"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "get",
          "list",
          "begin",
          "complete",
          "fail",
          "resume"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "objective": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "brief": {
        "type": "string",
        "maxLength": 12000
      },
      "projectId": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 160
      },
      "tags": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "string",
          "maxLength": 48
        }
      },
      "boardId": {
        "type": "string",
        "pattern": "^ptb_[a-f0-9]{24}$"
      },
      "generationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{1,79}$"
      },
      "generationBrief": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      },
      "prompt": {
        "type": "string",
        "maxLength": 12000
      },
      "sourceRefs": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "artifacts": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "quality": {
        "type": "object",
        "additionalProperties": true
      },
      "error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      },
      "retryable": {
        "type": "boolean"
      },
      "expectedRevision": {
        "type": "integer",
        "minimum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
