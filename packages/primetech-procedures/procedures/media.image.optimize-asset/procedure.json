{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "media.image.optimize-asset",
  "version": "0.1.0",
  "summary": "Create a verified derivative of an owned image using the installed native media optimization operation; preserve the source asset.",
  "effect": "project_write",
  "capabilities": [
    "media.image.optimize"
  ],
  "runtime": {
    "kind": "native_tool",
    "tool_key": "media.image.optimize"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "assetId"
    ],
    "properties": {
      "assetId": {
        "type": "string",
        "minLength": 1
      },
      "format": {
        "type": "string",
        "enum": [
          "png",
          "webp",
          "jpeg"
        ]
      },
      "quality": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "ok",
      "sourceAssetId",
      "sourceHash",
      "derivativeAssetId",
      "derivativeHash",
      "contentType",
      "bytes",
      "transformations"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "sourceAssetId": {
        "type": "string",
        "minLength": 1
      },
      "sourceHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "derivativeAssetId": {
        "type": "string",
        "minLength": 1
      },
      "derivativeHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "contentType": {
        "type": "string",
        "minLength": 1
      },
      "bytes": {
        "type": "integer",
        "minimum": 1
      },
      "transformations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
