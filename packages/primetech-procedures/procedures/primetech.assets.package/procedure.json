{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "primetech.assets.package",
  "version": "1.0.0",
  "summary": "Package approved creative assets with source hashes, metadata and delivery manifest.",
  "effect": "project_write",
  "capabilities": [
    "primetech.assets.package"
  ],
  "runtime": {
    "kind": "sam_operation",
    "operation": "primetech.assets.package"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "assetPaths"
    ],
    "properties": {
      "assetPaths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 512,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "outputDir": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "packageName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
