{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "primetech.visuals.compare",
  "version": "1.0.0",
  "summary": "Compare reference and rendered images and write diff, overlay, metrics and evidence report.",
  "effect": "project_write",
  "capabilities": [
    "primetech.visuals.compare"
  ],
  "runtime": {
    "kind": "sam_operation",
    "operation": "primetech.visuals.compare"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "referencePath",
      "renderedPath"
    ],
    "properties": {
      "referencePath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "renderedPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "outputDir": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "pixelThreshold": {
        "type": "integer",
        "minimum": 1,
        "maximum": 255
      },
      "maxMeanAbsoluteError": {
        "type": "number",
        "minimum": 0,
        "maximum": 255
      },
      "maxChangedPixelRatio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
