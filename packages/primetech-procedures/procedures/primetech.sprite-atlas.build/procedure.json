{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "primetech.sprite-atlas.build",
  "version": "1.0.0",
  "summary": "Pack ordered character or pet frames into a transparent sprite atlas with frame metadata and preview.",
  "effect": "project_write",
  "capabilities": [
    "primetech.sprite-atlas.build"
  ],
  "runtime": {
    "kind": "sam_operation",
    "operation": "primetech.sprite-atlas.build"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "framePaths"
    ],
    "properties": {
      "framePaths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "outputDir": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "columns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 32
      },
      "cellWidth": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "cellHeight": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "padding": {
        "type": "integer",
        "minimum": 0,
        "maximum": 128
      },
      "fps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      },
      "loop": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
