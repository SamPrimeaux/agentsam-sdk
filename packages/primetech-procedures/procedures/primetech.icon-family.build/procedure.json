{
  "schema": "inneranimalmedia.primetech.procedure.v1",
  "id": "primetech.icon-family.build",
  "version": "1.0.0",
  "summary": "Build a verified icon family from an approved SVG master with three shapes, eight colorways, raster sizes and source checksums.",
  "effect": "project_write",
  "capabilities": [
    "primetech.icon-family.build"
  ],
  "runtime": {
    "kind": "sam_operation",
    "operation": "primetech.icon-family.build"
  },
  "input_schema": {
    "type": "object",
    "required": [
      "sourceSvgPath",
      "colorways"
    ],
    "properties": {
      "sourceSvgPath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "outputDir": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "colorways": {
        "type": "array",
        "minItems": 8,
        "maxItems": 8,
        "items": {
          "type": "object",
          "required": [
            "id",
            "foreground",
            "background"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "technical-slate",
                "lagoon",
                "industrial-ember",
                "alloy-blue",
                "prime-electric",
                "prime-spectrum",
                "reverse",
                "core-mono"
              ]
            },
            "foreground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3,8}$"
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3,8}$"
            }
          },
          "additionalProperties": false
        }
      },
      "sizes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        }
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      }
    },
    "required": [
      "ok"
    ],
    "additionalProperties": true
  },
  "verification": {
    "kind": "output_schema"
  },
  "flags": {
    "network": false,
    "physical_hardware": false,
    "requires_operator_review": true
  }
}
