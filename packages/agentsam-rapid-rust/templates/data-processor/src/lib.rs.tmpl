use serde::{Deserialize, Serialize};
use worker::*;

#[derive(Debug, Deserialize, Serialize)]
struct BatchInput {
    items: Vec<RawItem>,
}

#[derive(Debug, Deserialize, Serialize)]
struct RawItem {
    id: u64,
    value: f64,
}

#[derive(Serialize)]
struct BatchResult {
    processed_count: usize,
    total_sum: f64,
    average: f64,
}

#[event(fetch)]
pub async fn main(req: Request, env: Env, _ctx: Context) -> Result<Response> {
    Router::new()
        .post_async("/process", |mut req, _ctx| async move {
            let data: BatchInput = match req.json().await {
                Ok(value) => value,
                Err(_) => return Response::error("invalid JSON payload", 400),
            };
            let count = data.items.len();
            let sum: f64 = data.items.iter().map(|item| item.value).sum();
            let average = if count == 0 { 0.0 } else { sum / count as f64 };
            Response::from_json(&BatchResult {
                processed_count: count,
                total_sum: sum,
                average,
            })
        })
        .run(req, env)
        .await
}
