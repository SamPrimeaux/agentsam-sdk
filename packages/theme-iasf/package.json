{
  "name": "@inneranimalmedia/theme-iasf",
  "version": "2.6.12",
  "description": "IASF — stock Inner Animal Storefront theme pack (normalized from studio-cms-editor harvest).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./content": "./src/content.js",
    "./tokens": "./src/tokens.js",
    "./styles/storefront.css": "./src/styles/storefront.css",
    "./favicon.svg": "./src/favicon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
