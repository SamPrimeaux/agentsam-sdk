    "aliases": [
      "inneranimals-site",
      "theme-inneranimals-site",
      "inner-animals-storefront"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/theme-iasf"
  }
