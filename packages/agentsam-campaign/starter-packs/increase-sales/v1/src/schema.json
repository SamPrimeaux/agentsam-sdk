{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSam Growth campaign starter",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "family",
    "objective_key",
    "fields",
    "assets",
    "channel_defaults",
    "required_checks",
    "reporting",
    "integrations"
  ],
  "properties": {
    "schema": {
      "const": "agentsam.growth.campaign-starter.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "family": {
      "const": "increase_sales"
    },
    "objective_key": {
      "const": "increase_sales"
    },
    "fields": {
      "type": "array",
      "minItems": 1
    },
    "channel_defaults": {
      "type": "array",
      "minItems": 1
    },
    "required_checks": {
      "type": "array",
      "minItems": 1
    },
    "assets": {
      "type": "object",
      "required": [
        "website",
        "email",
        "social",
        "product_card",
        "sms",
        "paid_ad"
      ]
    },
    "reporting": {
      "type": "object"
    },
    "integrations": {
      "type": "object"
    }
  }
}
