{
  "name": "@inneranimalmedia/theme-grove",
  "version": "2.6.11",
  "description": "A visual service-business prebuild centered on project galleries, material detail, process, reviews, and estimate conversion — polished enough for a studio, practical enough for a crew.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./site/*": "./site/*"
  },
  "files": [
    "src",
    "site",
    "README.md",
    "prebuild.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "agentsam": {
    "kind": "theme",
    "slug": "grove",
    "installable": true,
    "icon": "theme",
    "family": "service-gallery",
    "normalization": "package_ready",
    "canonicalId": "grove",
    "portable": true,
    "prebuildRoot": "site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/theme-grove"
  }
}
