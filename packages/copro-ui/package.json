{
  "name": "@inneranimalmedia/copro-ui",
  "version": "2.6.12",
  "description": "Mobile-first creator UI for CoPro with preview, timeline, direct manipulation, edit tools, media tray, transport, and responsive desktop composition.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/copro.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inneranimalmedia/copro-editor": "2.6.12",
    "@inneranimalmedia/copro-project": "2.6.12",
    "@inneranimalmedia/copro-timeline": "2.6.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "~5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "copro",
    "video-editor",
    "mobile-video-editor",
    "timeline",
    "creator-tools",
    "agentsam"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/copro-ui"
  },
  "bugs": {
    "url": "https://github.com/SamPrimeaux/agentsam-sdk/issues"
  },
  "homepage": "https://github.com/SamPrimeaux/agentsam-sdk#readme"
}
