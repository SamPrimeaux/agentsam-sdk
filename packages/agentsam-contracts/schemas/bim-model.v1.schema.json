{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/packages/agentsam-contracts/v1/bim-model.schema.json",
  "title": "AgentSam BIM Model v1",
  "description": "Engine-neutral semantics of an IFC file keyed by GlobalId. Shape only: referential integrity is checked by assertBimModel. Not proof the source IFC is valid or complete BIM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "project", "spatial", "types", "elements", "spaces", "counts", "truncated", "warnings"],
  "properties": {
    "schema": {"const": "agentsam.bim.model.v1"},
    "source": {"type": "object", "additionalProperties": false, "required": ["ifcSchema", "sha256", "byteLength"], "properties": {
      "ifcSchema": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "byteLength": {"type": "integer", "minimum": 0}}},
    "project": {"type": "object", "additionalProperties": false, "required": ["globalId", "name", "lengthUnit", "lengthScaleToM"], "properties": {
      "globalId": {"$ref": "#/$defs/globalId"},
      "name": {"type": ["string", "null"]},
      "lengthUnit": {"type": "string", "minLength": 1},
      "lengthScaleToM": {"type": "number", "exclusiveMinimum": 0}}},
    "spatial": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/spatialNode"}]},
    "types": {"type": "array", "items": {"$ref": "#/$defs/type"}},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "spaces": {"type": "array", "items": {"$ref": "#/$defs/space"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "truncated": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "globalId": {"type": "string", "pattern": "^[0-9A-Za-z_$]{22}$"},
    "nullableId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/globalId"}]},
    "nullableString": {"type": ["string", "null"]},
    "nullableNumber": {"type": ["number", "null"]},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "propertySets": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scalar"}}},
    "material": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
      "name": {"type": "string"},
      "layers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["material", "thicknessM"], "properties": {
        "material": {"type": "string"}, "thicknessM": {"$ref": "#/$defs/nullableNumber"}}}}}},
    "spatialNode": {"type": "object", "additionalProperties": false, "required": ["globalId", "ifcClass", "name", "children"], "properties": {
      "globalId": {"$ref": "#/$defs/globalId"},
      "ifcClass": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
      "name": {"$ref": "#/$defs/nullableString"},
      "elevationM": {"$ref": "#/$defs/nullableNumber"},
      "children": {"type": "array", "items": {"$ref": "#/$defs/spatialNode"}}}},
    "type": {"type": "object", "additionalProperties": false, "required": ["globalId", "ifcClass", "name", "predefinedType", "psets"], "properties": {
      "globalId": {"$ref": "#/$defs/globalId"},
      "ifcClass": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
      "name": {"$ref": "#/$defs/nullableString"},
      "predefinedType": {"$ref": "#/$defs/nullableString"},
      "material": {"$ref": "#/$defs/material"},
      "psets": {"$ref": "#/$defs/propertySets"}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["globalId", "ifcClass", "name", "predefinedType", "typeId", "containerId", "psets", "qtos", "hostId", "openingIds", "fillsOpeningId"], "properties": {
      "globalId": {"$ref": "#/$defs/globalId"},
      "ifcClass": {"type": "string", "pattern": "^Ifc[A-Za-z0-9]+$"},
      "name": {"$ref": "#/$defs/nullableString"},
      "predefinedType": {"$ref": "#/$defs/nullableString"},
      "typeId": {"$ref": "#/$defs/nullableId"},
      "containerId": {"$ref": "#/$defs/nullableId"},
      "material": {"$ref": "#/$defs/material"},
      "psets": {"$ref": "#/$defs/propertySets"},
      "qtos": {"$ref": "#/$defs/propertySets"},
      "hostId": {"$ref": "#/$defs/nullableId"},
      "openingIds": {"type": "array", "items": {"$ref": "#/$defs/globalId"}},
      "fillsOpeningId": {"$ref": "#/$defs/nullableId"}}},
    "space": {"type": "object", "additionalProperties": false, "required": ["globalId", "name", "longName", "containerId", "usage", "netFloorAreaM2", "grossFloorAreaM2", "heightM", "hasGeometry"], "properties": {
      "globalId": {"$ref": "#/$defs/globalId"},
      "name": {"$ref": "#/$defs/nullableString"},
      "longName": {"$ref": "#/$defs/nullableString"},
      "containerId": {"$ref": "#/$defs/nullableId"},
      "usage": {"$ref": "#/$defs/nullableString"},
      "netFloorAreaM2": {"$ref": "#/$defs/nullableNumber"},
      "grossFloorAreaM2": {"$ref": "#/$defs/nullableNumber"},
      "heightM": {"$ref": "#/$defs/nullableNumber"},
      "hasGeometry": {"type": "boolean"}}}
  }
}
