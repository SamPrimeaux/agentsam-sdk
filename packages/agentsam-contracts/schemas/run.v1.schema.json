{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/packages/agentsam-contracts/v1/agentsam.run.v1.schema.json",
  "title": "AgentRunV1",
  "description": "ACP lifecycle projection. status is the public lifecycle view; storageStatus is the narrower persisted runtime status.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "status",
    "storageStatus",
    "cancelRequested",
    "modelCallCount",
    "toolCallCount",
    "inputTokens",
    "cachedInputTokens",
    "outputTokens",
    "reasoningTokens",
    "costUsd"
  ],
  "properties": {
    "schema": {
      "const": "agentsam.run.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "accountId": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "parentRunId": {
      "type": "string"
    },
    "externalAgentId": {
      "type": "string"
    },
    "externalRunId": {
      "type": "string"
    },
    "sourceClient": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "ask",
        "plan",
        "agent",
        "debug",
        "multitask"
      ]
    },
    "modelKey": {
      "type": "string"
    },
    "reasoningEffort": {
      "type": "string"
    },
    "requestedServiceTier": {
      "type": "string"
    },
    "actualServiceTier": {
      "type": "string"
    },
    "selectedBy": {
      "enum": [
        "manual",
        "automatic",
        "fallback"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting_external",
        "waiting_child",
        "awaiting_input",
        "awaiting_approval",
        "sleeping",
        "retry_scheduled",
        "partial",
        "completed",
        "cancelled",
        "failed",
        "timed_out"
      ]
    },
    "storageStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "partial",
        "cancelled"
      ]
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "errorCode": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string"
    },
    "modelCallCount": {
      "type": "integer",
      "minimum": 0
    },
    "toolCallCount": {
      "type": "integer",
      "minimum": 0
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cachedInputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "reasoningTokens": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "number"
    },
    "startedAt": {
      "type": "number"
    },
    "completedAt": {
      "type": "number"
    },
    "updatedAt": {
      "type": "number"
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "$defs": {},
  "additionalProperties": false
}
