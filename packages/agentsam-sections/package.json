{
  "name": "@inneranimalmedia/agentsam-sections",
  "version": "0.1.0",
  "description": "Reusable mxs-* page kit: global header/footer, scroll-driven split sections, and a media slot for image, gif, video, glb and sandboxed app previews.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mxs.css": "./styles/mxs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "artifact.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "~5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentsam",
    "sections",
    "scroll-animation",
    "media",
    "glb",
    "layout"
  ]
}
