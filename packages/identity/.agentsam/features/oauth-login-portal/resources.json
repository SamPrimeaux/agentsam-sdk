{
  "schema": "agentsam.feature.resources.v1",
  "feature": "identity.oauth-login-portal",
  "engine": "d1",
  "migration_sources": [
    "src/migrations/0001_identity_core.sql",
    "src/migrations/0002_company.sql",
    "src/migrations/0003_accounts_ssot.sql"
  ],
  "notes": "Migration files remain the schema authority. accounts is the account SSOT; account_identities is IdP linkage only.",
  "tables": [
    {
      "name": "accounts",
      "purpose": "account SSOT (row of record)",
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "auth_users",
      "purpose": "login principal (1:1 with accounts.id in portable scaffold)",
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "auth_sessions",
      "purpose": "authenticated browser/session state",
      "owner_column": "user_id",
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "account_identities",
      "purpose": "IdP linkage only (provider + subject → accounts.id) — not the account SSOT",
      "owner_column": "account_id",
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "oauth_states",
      "purpose": "short-lived OAuth/PKCE transaction state",
      "sensitive": true,
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "password_reset_tokens",
      "purpose": "password recovery token state",
      "sensitive": true,
      "owner_column": "user_id",
      "source": "src/migrations/0001_identity_core.sql"
    },
    {
      "name": "company",
      "purpose": "auth portal/company branding",
      "source": "src/migrations/0002_company.sql"
    }
  ]
}
