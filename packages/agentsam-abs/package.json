{
  "name": "@inneranimalmedia/agentsam-abs",
  "version": "1.0.0",
  "description": "AgentSam Auto Browser Shell: dual-mode Explore/Build browser surface with provider-agnostic generative navigation, sandboxed previews, deterministic history, and packaged runtime scenes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./theme.css": "./styles/theme.css",
    "./browser.css": "./styles/browser.css",
    "./package.json": "./package.json",
    "./tokens.css": "./styles/tokens.css",
    "./components.css": "./styles/components.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "artifact.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-loading-scene": "2.6.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "~5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentsam",
    "browser-shell",
    "generative-browser",
    "sandbox",
    "runtime-visualization",
    "rapid-prototyping"
  ]
}
