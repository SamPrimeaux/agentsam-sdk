{
  "name": "@inneranimalmedia/agentsam-merch",
  "version": "2.6.13",
  "description": "Provider-neutral manufacturing profiles, preflight, derivative planning, and collection-lab primitives for AgentSam.",
  "type": "module",
  "files": [
    "src",
    "profiles",
    "bin",
    "README.md",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./profiles": "./src/profile.js",
    "./registry": "./src/profile-registry.js",
    "./compatibility": "./src/compatibility.js",
    "./derivatives": "./src/derivatives.js",
    "./collection-lab": "./src/collection-lab.js",
    "./adapters/completeful": "./src/adapters-completeful.js",
    "./profiles/*": "./profiles/*",
    "./transforms": {
      "types": "./src/index.d.ts",
      "import": "./src/transforms.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "import": "./src/node/index.js"
    },
    "./collection-planning": {
      "types": "./src/collection-planning.d.ts",
      "import": "./src/collection-planning.js"
    },
    "./merch-hero": {
      "types": "./src/merch-hero.d.ts",
      "import": "./src/merch-hero.js"
    },
    "./merch-hero.css": "./src/merch-hero.css",
    "./collection-showcase": {
      "types": "./src/collection-showcase.d.ts",
      "import": "./src/collection-showcase.js"
    },
    "./collection-showcase.css": "./src/collection-showcase.css"
  },
  "bin": {
    "agentsam-merch": "./bin/agentsam-merch.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "FSL-1.1-MIT",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-merch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0",
    "svgo": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "svgo": {
      "optional": true
    }
  }
}
