{
  "name": "@inneranimalmedia/agentsam-vault",
  "version": "2.6.11",
  "type": "module",
  "description": "AgentSam credential vault core — contracts, AES-GCM crypto, provider registry, resolver. UI lives in agentsam-key-manager.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./contracts": {
      "types": "./src/contracts/credential.d.ts",
      "default": "./src/contracts/credential.js"
    },
    "./providers": "./src/providers/registry.js",
    "./crypto": {
      "types": "./src/crypto/aes-gcm.d.ts",
      "default": "./src/crypto/aes-gcm.js"
    },
    "./resolver": "./src/runtime/resolver.js",
    "./oauth": "./src/crypto/oauth-envelope.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-vault"
  },
  "files": [
    "src",
    "README.md"
  ],
  "license": "MIT"
}
