{
  "name": "@inneranimalmedia/agentsam-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentSam credential vault core \u2014 contracts, AES-GCM crypto, provider registry, resolver. UI lives in agentsam-key-manager.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./contracts": {
      "types": "./src/contracts/credential.d.ts",
      "default": "./src/contracts/credential.js"
    },
    "./providers": "./src/providers/registry.js",
    "./crypto": {
      "types": "./src/crypto/aes-gcm.d.ts",
      "default": "./src/crypto/aes-gcm.js"
    },
    "./resolver": "./src/runtime/resolver.js",
    "./oauth": "./src/crypto/oauth-envelope.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
