{
  "name": "@inneranimalmedia/agentsam-shell-kit",
  "version": "2.6.9",
  "description": "Compatibility facade for the AgentSam workbench shell. New code uses @inneranimalmedia/agentsam-workbench.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state/index.d.ts",
      "import": "./dist/empty-state/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "^5.4.0",
    "esbuild": "^0.28.1"
  },
  "keywords": [
    "agentsam",
    "shell",
    "tickets",
    "verify",
    "ui",
    "components"
  ],
  "author": "Sam Primeaux <sam@inneranimalmedia.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-shell-kit"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-workbench": "2.6.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/empty-state/EmptyState.css"
  ]
}
