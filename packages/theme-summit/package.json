{
  "name": "@inneranimalmedia/theme-summit",
  "version": "2.6.12",
  "description": "A restrained consulting and portfolio prebuild with editorial services, case studies, multilingual-ready structure, media, and thoughtful spacing that lets expertise do the talking.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./site/*": "./site/*"
  },
  "files": [
    "src",
    "site",
    "README.md",
    "prebuild.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "agentsam": {
