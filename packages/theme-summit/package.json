    "slug": "summit",
    "installable": true,
    "icon": "theme",
    "family": "consulting-portfolio",
    "normalization": "package_ready",
    "canonicalId": "summit",
    "portable": true,
    "prebuildRoot": "site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/theme-summit"
  }
