{
  "name": "@inneranimalmedia/agentsam-workbench",
  "version": "2.6.10",
  "description": "Reusable AgentSam workbench primitives for agent threads, composer, browser, terminal and resizable work surfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    },
    "./projects": {
      "types": "./dist/projects/index.d.ts",
      "import": "./dist/projects/index.js"
    },
    "./timeline": {
      "types": "./dist/timeline/index.d.ts",
      "import": "./dist/timeline/index.js"
    },
    "./agent/mini-agentsam.css": "./dist/agent/mini-agentsam.css",
    "./agent/contextual-composer.css": "./dist/agent/contextual-composer.css",
    "./agent/tool-permission.css": "./dist/agent/tool-permission.css",
    "./project-control.css": "./dist/project-control.css",
    "./manufacturing": {
      "types": "./dist/manufacturing/index.d.ts",
      "import": "./dist/manufacturing/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./widgets/widgets.css": "./dist/widgets/widgets.css"
  },
  "scripts": {
    "typecheck": "node scripts/ensure-local-deps.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-contracts": "2.6.10",
    "@inneranimalmedia/agentsam-loading-scene": "2.6.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-workbench"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts"
}
