{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inneranimalmedia.com/schemas/cms-package.v2.schema.json",
  "title": "Inner Animal Media CMS Package v2",
  "description": "Portable CMS package contract. Declares logical capabilities and adapter bindings without embedding provider account resource IDs or customer routing guesses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "runtime", "capabilities", "distribution", "gates"],
  "properties": {
    "apiVersion": { "const": "inneranimalmedia.com/cms/v2" },
    "kind": { "const": "CmsPackage" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "endpoints"],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiBaseUrl", "assetBaseUrl"],
          "properties": {
            "apiBaseUrl": { "type": "string", "minLength": 1 },
            "assetBaseUrl": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "objectStorage"],
      "properties": {
        "database": { "$ref": "#/$defs/requiredCapability" },
        "objectStorage": { "$ref": "#/$defs/requiredCapability" },
        "cache": { "$ref": "#/$defs/optionalCapability" },
        "queue": { "$ref": "#/$defs/optionalCapability" },
        "collaboration": { "$ref": "#/$defs/optionalCapability" },
        "ai": { "$ref": "#/$defs/optionalCapability" }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sqlitePath": { "type": "string", "minLength": 1 },
            "contentPath": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["local_authority", "local_working_copy"] },
            "schemaPath": { "type": "string", "minLength": 1 }
          }
        },
        "cloudflare": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databaseBinding": { "type": "string", "minLength": 1 },
            "objectStorageBinding": { "type": "string", "minLength": 1 },
            "cacheBinding": { "type": "string", "minLength": 1 },
            "queueBinding": { "type": "string", "minLength": 1 },
            "aiBinding": { "type": "string", "minLength": 1 }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connectionEnv": { "type": "string", "minLength": 1 }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpointEnv": { "type": "string", "minLength": 1 },
            "bucketEnv": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studio", "pipeline"],
      "properties": {
        "studio": { "$ref": "#/$defs/distributionEntry" },
        "pipeline": { "$ref": "#/$defs/distributionEntry" }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema_valid",
          "capabilities_resolved",
          "database_migrated",
          "api_conformance",
          "studio_build",
          "preview_smoke",
          "publish_smoke"
        ]
      }
    }
  },
  "$defs": {
    "requiredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "publicOrigin": { "type": "string", "minLength": 1 }
      }
    },
    "optionalCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": { "type": "boolean" },
        "role": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "distributionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "entry"],
      "properties": {
        "source": { "enum": ["package", "external"] },
        "entry": { "type": "string", "minLength": 1 }
      }
    }
  }
}
