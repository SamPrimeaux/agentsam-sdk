{
  "name": "@inneranimalmedia/agentsam-settings",
  "version": "2.6.18",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./appearance": {
      "types": "./dist/appearance.d.ts",
      "import": "./dist/appearance.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "import": "./dist/frontend/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./frontend/styles.css": "./dist/frontend/index.css"
  },
  "peerDependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@inneranimalmedia/agentsam-contracts": "2.6.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-settings"
  },
  "files": [
    "dist",
    "README.md",
    "examples/standalone"
  ],
  "description": "Portable AgentSam Settings shell, contracts, fixtures, and host adapter surface for desktop and hosted applications.",
  "license": "FSL-1.1-MIT",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "prepack": "npm run build",
    "dev:preview": "npm run build && vite --config examples/standalone/vite.config.ts --host 127.0.0.1 --port 4173",
    "build:preview": "npm run build && vite build --config examples/standalone/vite.config.ts"
  },
  "devDependencies": {
    "@inneranimalmedia/agentsam-brand": "2.6.18",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0",
    "@inneranimalmedia/agentsam-workbench": "2.6.18",
    "@inneranimalmedia/agentsam-contracts": "2.6.18"
  }
}
