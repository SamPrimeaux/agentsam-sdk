{
  "name": "@inneranimalmedia/theme-forge",
  "version": "2.6.12",
  "description": "A mobile-first local-services prebuild with estimate capture, service-area confidence, project proof, reviews, and practical trust signals that stay sharp on the smallest screen.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./site/*": "./site/*"
  },
  "files": [
    "src",
    "site",
    "README.md",
    "prebuild.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "agentsam": {
    "kind": "theme",
    "slug": "forge",
    "installable": true,
    "icon": "theme",
    "family": "trade-services",
    "normalization": "package_ready",
    "canonicalId": "forge",
    "portable": true,
    "prebuildRoot": "site"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamForge/agentsam-sdk.git",
    "directory": "packages/theme-forge"
  }
}
