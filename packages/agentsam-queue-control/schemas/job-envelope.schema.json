{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inneranimalmedia.com/schemas/agentsam/queue-control/job-envelope.v1.schema.json",
  "title": "AgentSam Queue Job Envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "account_id",
    "kind",
    "executor",
    "priority",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "logical_queue": {
      "type": [
        "string",
        "null"
      ]
    },
    "executor": {
      "enum": [
        "inline",
        "queue",
        "workflow",
        "execos",
        "worker_rpc",
        "openai_batch",
        "gemini_batch",
        "external"
      ]
    },
    "priority": {
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "claimed",
        "running",
        "waiting",
        "batch_waiting",
        "awaiting_input",
        "retry_scheduled",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "payload": {},
    "payload_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoff": {
          "enum": [
            "fixed",
            "exponential"
          ]
        },
        "initial_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "jitter": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "available_at": {
      "type": "integer",
      "minimum": 0
    },
    "source_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lease_generation": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
