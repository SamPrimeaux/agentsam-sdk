{
  "name": "@inneranimalmedia/agentsam-ide",
  "version": "2.6.11",
  "description": "AgentSam IDE packages — Monaco, file tree, xterm, LSP client, first-login onboarding. Rapidly deployable into Local Studio / desktop.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./monaco": {
      "types": "./dist/monaco/index.d.ts",
      "import": "./dist/monaco/index.js"
    },
    "./filetree": {
      "types": "./dist/filetree/index.d.ts",
      "import": "./dist/filetree/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js"
    },
    "./lsp": {
      "types": "./dist/lsp/index.d.ts",
      "import": "./dist/lsp/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "import": "./dist/onboarding/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/xterm": "^5 || ^6",
    "@xterm/addon-fit": "^0.10 || ^0.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-ide"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "license": "MIT"
}
