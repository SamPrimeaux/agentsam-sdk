{
  "name": "@inneranimalmedia/agentsam-ide",
  "version": "0.1.0",
  "private": true,
  "description": "AgentSam IDE packages — Monaco, file tree, xterm, LSP client, first-login onboarding. Rapidly deployable into Local Studio / desktop.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./monaco": "./src/monaco/index.ts",
    "./filetree": "./src/filetree/index.ts",
    "./terminal": "./src/terminal/index.ts",
    "./lsp": "./src/lsp/index.ts",
    "./onboarding": "./src/onboarding/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/xterm": "^5 || ^6",
    "@xterm/addon-fit": "^0.10 || ^0.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
