{
  "name": "@inneranimalmedia/agentsam-cms",
  "version": "2.6.17",
  "description": "Canonical CMS operations for merchant Page Editor, Theme Studio and publication with host-owned persistence; no SQL bootstrap.",
  "type": "module",
  "files": [
    "src",
    "test",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js"
    },
    "./account-context": "./src/account-context.js",
    "./chat-storage": "./src/chat-storage.js",
    "./site-settings": "./src/site-settings-contract.js",
    "./site-nav-defaults": "./src/site-nav-defaults.js",
    "./application": {
      "types": "./src/index.d.ts",
      "import": "./src/application.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-cms"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-contracts": "2.6.17"
  }
}
