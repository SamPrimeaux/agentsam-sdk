{
  "name": "@inneranimalmedia/agentsam-nav",
  "version": "0.1.0",
  "private": false,
  "description": "Reusable responsive navigation primitives for AgentSam dashboard-family applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./browser.global.js": "./dist/browser.global.js",
    "./theme.css": "./dist/theme.css",
    "./legacy.css": "./dist/legacy.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "lucide-react": "^0.510.0"
  }
}
