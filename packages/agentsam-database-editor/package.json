{
  "name": "@inneranimalmedia/agentsam-database-editor",
  "version": "2.6.9",
  "type": "module",
  "description": "Portable AgentSam Database Editor — adapters for SQLite/D1/Postgres/Supabase + vectors surface. Donor: IAM /dashboard/database.",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./manifest": "./src/manifest.js",
    "./contracts": "./src/contracts/index.js",
    "./adapters/sqlite": "./src/adapters/sqlite.js",
    "./adapters/d1": "./src/adapters/d1.js",
    "./adapters/postgres": "./src/adapters/postgres.js",
    "./adapters/supabase": "./src/adapters/supabase.js",
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/client": {
      "types": "./dist/src/ui/client.d.ts",
      "import": "./dist/ui/client.js"
    },
    "./metrics/d1": "./src/metrics/d1.js",
    "./metrics/postgres": "./src/metrics/postgres.js",
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "import": "./dist/frontend/index.js"
    },
    "./backend": "./backend/index.js",
    "./backend/sqlite": "./backend/sqlite.js"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/src/ui/database-editor.css"
  ],
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18",
    "react-dom": ">=18",
    "recharts": ">=2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/agentsam-database-editor"
  },
  "files": [
    "backend",
    "dist",
    "src",
    "bin",
    "scripts",
    "agentsam.app.json",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "typescript": "^5.9.3"
  }
}
