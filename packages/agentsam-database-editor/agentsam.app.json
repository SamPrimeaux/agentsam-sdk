{
  "schema": "agentsam.app.v1",
  "id": "database-editor",
  "name": "AgentSam Database Editor",
  "kind": "app",
  "directory_id_exception": true,
  "display_name": "Database Editor",
  "package": "@inneranimalmedia/agentsam-database-editor",
  "icon": "database",
  "entrypoints": {
    "cli": "./bin/agentsam-database-editor.mjs"
  },
  "install": {
    "supported": true,
    "selector": "database-editor",
    "paths": ["/install/database", "/install/database-editor"],
    "command": "agentsam app install database-editor",
    "curl": "curl -fsSL https://agentsam.inneranimalmedia.com/install | bash -s -- --app-id database-editor"
  },
  "preview": {
    "supported": true,
    "route": "/database"
  },
  "routes": {
    "home": "/database",
    "connections": "/database/connections",
    "vectors": "/database/vectors"
  },
  "capabilities": [
    "database.inspect",
    "database.query",
    "database.edit",
    "vectors.inspect"
  ],
  "empty_state": {
    "title": "No databases connected",
    "description": "Open a local SQLite database or connect a hosted database. Vectors are optional.",
    "primary_label": "Open local database",
    "secondary_label": "Connect database"
  },
  "bin": "bin/agentsam-database-editor.mjs"
}
