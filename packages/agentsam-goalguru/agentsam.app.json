{
  "schema": "agentsam.app.v1",
  "id": "goalguru",
  "name": "AgentSam GoalGuru",
  "kind": "app",
  "display_name": "GoalGuru",
  "package": "@inneranimalmedia/agentsam-goalguru",
  "version": "2.6.18",
  "icon": "target",
  "category": "productivity",
  "routes": {
    "home": "/goalguru",
    "app.authenticated": {
      "path": "/goalguru",
      "auth": "required",
      "spa": true
    },
    "app.home": {
      "path": "/goalguru"
    },
    "identity.login": {
      "path": "/auth/login"
    },
    "identity.recovery": {
      "path": "/auth/login"
    },
    "identity.oauth.start": {
      "path": "/api/oauth/:provider/start"
    },
    "identity.oauth.callback": {
      "path": "/api/oauth/:provider/callback"
    },
    "entry": "/goalguru",
    "mounts": [
      {
        "path": "/goalguru",
        "auth": "required",
        "spa": true
      }
    ]
  },
  "surfaces": [
    "standalone",
    "side-stage"
  ],
  "capabilities": [
    "goals.manage",
    "goals.steps",
    "goals.tickets.link"
  ],
  "requires": [
    "account.authenticated",
    "goals.api"
  ],
  "optional": [
    "agentsam.work"
  ],
  "install": {
    "supported": true,
    "selector": "goalguru",
    "command": "agentsam app install goalguru"
  },
  "entrypoints": {
    "frontend": "./dist/index.js",
    "manifest": "./agentsam.app.json"
  },
  "directory_id_exception": true,
  "product_id": "goalguru",
  "auth": {
    "required": true,
    "entry": {
      "authenticated": "app.authenticated",
      "login": "identity.login",
      "failure": "identity.recovery"
    }
  },
  "screens": [
    {
      "id": "goalguru.workspace",
      "app_id": "goalguru",
      "route": "/admin/goalguru",
      "primary": true,
      "module": "routes/(apps)/admin/goalguru.tsx",
      "export": "GoalGuruPage",
      "mount": {
        "type": "host-component",
        "scope": "host"
      },
      "navigation": {
        "surface": "admin-nav",
        "label": "GoalGuru",
        "icon": "target",
        "primary": true
      }
    }
  ]
}
