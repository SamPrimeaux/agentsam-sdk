{
  "schema": "agentsam.prebuild.v1",
  "id": "resolve",
  "package": "@inneranimalmedia/theme-resolve",
  "version": "2.6.11",
  "siteRoot": "site",
  "entrypoint": "index.html",
  "rootDeployable": true,
  "portable": true,
  "materializer": {
    "export": "@inneranimalmedia/theme-resolve/node",
    "function": "materializePrebuild"
  },
  "defaults": {
    "basePath": "/",
    "canonicalOrigin": "https://example.com/",
    "apiBasePath": "/api"
  },
  "notes": [
    "Static site payload is shipped in this package.",
    "Backend/API capabilities are supplied by the host and are never simulated by the package."
  ]
}
