{
  "name": "@inneranimalmedia/theme-resolve",
  "version": "2.6.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamPrimeaux/agentsam-sdk.git",
    "directory": "packages/theme-resolve"
  },
  "description": "A high-fashion commerce prebuild built around cinematic scroll, shoppable editorial, sticky purchase rails, lookbooks, stories, bundles, and micro-interactions that make the storefront feel directed instead of assembled.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./site/*": "./site/*",
    "./portal": "./src/portal-templates.mjs"
  },
  "files": [
    "src",
    "site",
    "README.md",
    "prebuild.json",
    "scripts"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync:demo-catalog": "python3 scripts/sync-demo-catalog.py"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "FSL-1.1-MIT",
  "agentsam": {
    "kind": "theme",
    "slug": "resolve",
    "installable": true,
    "icon": "theme",
    "family": "luxury-commerce",
    "canonicalId": "resolve",
    "normalization": "package_ready",
    "portable": true,
    "prebuildRoot": "site"
  }
}
