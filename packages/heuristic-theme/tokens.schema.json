{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/packages/theme-heuristic/v1/tokens.schema.json",
  "title": "Heuristic Commerce Theme Tokens",
  "description": "Design tokens consumed by the Heuristic Commerce storefront theme.",
  "type": "object",
  "required": [
    "scope",
    "color",
    "type",
    "shape",
    "layout",
    "motion"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "type": {
      "type": "object",
      "required": [
        "display",
        "body",
        "mono"
      ],
      "properties": {
        "display": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "layout": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "motion": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
