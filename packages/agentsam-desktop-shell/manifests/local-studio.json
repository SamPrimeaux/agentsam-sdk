{
  "$schema": "./schema.json",
  "app_id": "local-studio",
  "app_name": "AgentSam Local Studio",
  "bundle_identifier": "com.inneranimalmedia.local-studio",
  "base_url": "app://local-studio",
  "surface": "app",
  "launch_path": "/agentsam",
  "routes": {
    "home": "/agentsam",
    "login": "/auth/login",
    "logout": "/api/auth/logout",
    "next_after_login": "/agentsam"
  },
  "auth": {
    "authority": "service",
    "ui": "bundled-auth-portal",
    "service_origin": "install-config",
    "native_session": "bearer",
    "session_store": "os_secure_store",
    "standalone_adapter": "sqlite",
    "notes": "Official connected builds use the configured identity service/main DB. SQLite identity is explicit standalone mode only."
  },
  "deep_link_scheme": "agentsamstudio",
  "identity_provider": "portable",
  "brand_family": "agentsam",
  "product_mark_variant": "local-studio-portal",
  "version": "2.6.7",
  "icon_set": "icons/local-studio",
  "icon_mark_svg": "icons/local-studio/AgentSam-Mark.svg",
  "app_icon": {
    "mark": "icons/local-studio/AgentSam-Mark.svg",
    "surfaces": {
      "agentsam.graphite": {
        "base": "#12141a",
        "raised": "#1a1d26",
        "mark_fill": "#e8eaef"
      }
    },
    "profiles": {
      "macos": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.74,
        "size": 1024
      },
      "ios": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.78,
        "system_mask": true,
        "size": 1024
      },
      "windows": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.76,
        "size": 1024
      },
      "tray": {
        "mark_only": true,
        "size": 128
      },
      "android": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.78,
        "adaptive_icon": true,
        "size": 1024
      },
      "linux": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.76,
        "size": 1024
      }
    }
  },
  "included_apps": [
    "cad-creator"
  ],
  "theme": {
    "primary_color": "#0a0a0c",
    "accent_color": "#6366f1"
  },
  "feature_flags": {
    "tray": true,
    "auto_update": true,
    "local_execution_node": true,
    "offline_shell": false,
    "desktop_spa": true,
    "agentsamd_sidecar": true
  },
  "local_state": {
    "adapter": "sqlite",
    "authority": "device",
    "roles": [
      "workspace_state",
      "cache",
      "offline_outbox",
      "runtime_state"
    ]
  },
  "platform_profiles": {
    "desktop": {
      "targets": [
        "macos",
        "windows",
        "linux"
      ],
      "native_runtime": "agentsamd",
      "js_bridge_runtime": "bundled-node",
      "terminal_shells": {
        "macos": [
          "zsh",
          "bash",
          "sh"
        ],
        "windows": [
          "pwsh",
          "powershell",
          "cmd"
        ],
        "linux": [
          "bash",
          "zsh",
          "sh"
        ]
      },
      "secure_store": "os_secure_store"
    },
    "mobile": {
      "targets": [
        "ios",
        "android"
      ],
      "native_runtime": "mobile_adapter",
      "js_bridge_runtime": "none",
      "terminal_shells": [],
      "secure_store": "mobile_secure_store",
      "notes": "Mobile must not depend on executable sidecars; it consumes the same identity/service and local-state contracts through native mobile adapters."
    }
  }
}
