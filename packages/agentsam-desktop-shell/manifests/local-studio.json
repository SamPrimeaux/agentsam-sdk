{
  "$schema": "./schema.json",
  "app_id": "local-studio",
  "app_name": "AgentSam Local Studio",
  "bundle_identifier": "com.inneranimalmedia.local-studio",
  "base_url": "https://agentsam.inneranimalmedia.com",
  "surface": "app",
  "launch_path": "/agentsam",
  "routes": {
    "home": "/agentsam",
    "login": "/auth/login",
    "logout": "/api/auth/logout",
    "next_after_login": "/agentsam"
  },
  "auth": {
    "login_url": "/api/oauth/cloudflare/start?next=/agentsam",
    "session_check": "/api/auth/session",
    "oauth_client_id": "GOOGLE_DESKTOP_CLIENT_ID",
    "cloudflare_oauth_client_id": "CLOUDFLARE_OAUTH_CLIENT_ID",
    "login_mode": "google_desktop_pkce",
    "oauth_deep_link": "agentsamstudio://callback",
    "notes": "Desktop: GOOGLE_DESKTOP_CLIENT_ID (PKCE loopback) + Studio CLOUDFLARE_OAUTH_CLIENT_ID (offline). Never inneranimalmedia.com/auth/login with iam_agentsam_sdk_web."
  },
  "deep_link_scheme": "agentsamstudio",
  "identity_provider": "google_desktop_and_cloudflare",
  "brand_family": "agentsam",
  "product_mark_variant": "local-studio-portal",
  "version": "2.6.5",
  "icon_set": "icons/local-studio",
  "icon_source_url": "https://asr.inneranimalmedia.com/brands/agentsam/app-icon/v1/raster/AgentSam-Icon-1024.png",
  "icon_mark_svg": "icons/local-studio/AgentSam-Mark.svg",
  "app_icon": {
    "mark": "icons/local-studio/AgentSam-Mark.svg",
    "mark_url": "https://asr.inneranimalmedia.com/brands/agentsam/app-icon/v1/vector/AgentSam-Mark.svg",
    "fallback_master": "https://asr.inneranimalmedia.com/brands/agentsam/app-icon/v1/raster/AgentSam-Icon-1024.png",
    "surfaces": {
      "agentsam.graphite": {
        "base": "#12141a",
        "raised": "#1a1d26",
        "mark_fill": "#e8eaef"
      }
    },
    "profiles": {
      "macos": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.74,
        "size": 1024
      },
      "ios": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.78,
        "system_mask": true,
        "size": 1024
      },
      "windows": {
        "surface": "agentsam.graphite",
        "optical_scale": 0.76,
        "size": 1024
      },
      "tray": {
        "mark_only": true,
        "size": 128
      }
    }
  },
  "included_apps": [],
  "theme": {
    "primary_color": "#0a0a0c",
    "accent_color": "#6366f1"
  },
  "feature_flags": {
    "tray": true,
    "auto_update": true,
    "local_execution_node": true,
    "offline_shell": true,
    "agentsamd_sidecar": true
  }
}
