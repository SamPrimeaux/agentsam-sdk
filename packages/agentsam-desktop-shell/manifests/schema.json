{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentSam Desktop Brand Manifest",
  "type": "object",
  "required": ["app_id", "app_name", "bundle_identifier", "base_url", "deep_link_scheme", "identity_provider"],
  "properties": {
    "app_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "app_name": { "type": "string" },
    "bundle_identifier": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "base_url": { "type": "string", "format": "uri" },
    "surface": {
      "type": "string",
      "enum": ["workspace", "app", "store", "portal", "brand"]
    },
    "launch_path": { "type": "string", "pattern": "^/.*" },
    "routes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "properties": {
        "home": { "type": "string" },
        "login": { "type": "string" },
        "logout": { "type": "string" },
        "next_after_login": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "login_url": { "type": "string" },
        "session_check": { "type": "string" },
        "oauth_deep_link": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "allowed_web_origins": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "deep_link_scheme": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "icon_set": { "type": "string" },
    "icon_source_url": {
      "type": "string",
      "format": "uri",
      "description": "Optional HTTPS URL to a PNG (prefer 1024×1024). Overrides icon_set when set; also overridable via --icon-url / BRAND_ICON_URL / <APP_ID>_ICON_URL at build time."
    },
    "icon_mark_svg": {
      "type": "string",
      "description": "Relative path to Agent Sam mark SVG used as the editable brand source before rasterization."
    },
    "app_icon": {
      "type": "object",
      "description": "Platform app-icon composition contract: SVG mark + named surfaces + per-platform profiles → masters → tauri icon. Prefer over raw icon_source_url.",
      "properties": {
        "mark": {
          "type": "string",
          "description": "Relative path to the authoritative vector mark (preferred over delivery-variant rasters)."
        },
        "mark_url": {
          "type": "string",
          "format": "uri",
          "description": "Canonical remote vector (R2 app-icon role). Not Cloudflare Images avatar/hero/public variants."
        },
        "fallback_master": {
          "type": "string",
          "format": "uri",
          "description": "1024 raster reference/fallback when SVG composition is unavailable."
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base": { "type": "string" },
              "raised": { "type": "string" },
              "mark_fill": { "type": "string" }
            },
            "required": ["base"]
          }
        },
        "profiles": {
          "type": "object",
          "properties": {
            "macos": {
              "type": "object",
              "properties": {
                "surface": { "type": "string" },
                "optical_scale": { "type": "number", "minimum": 0.5, "maximum": 0.92 },
                "size": { "type": "integer" }
              }
            },
            "ios": {
              "type": "object",
              "properties": {
                "surface": { "type": "string" },
                "optical_scale": { "type": "number", "minimum": 0.5, "maximum": 0.92 },
                "system_mask": { "type": "boolean" },
                "size": { "type": "integer" }
              }
            },
            "windows": {
              "type": "object",
              "properties": {
                "surface": { "type": "string" },
                "optical_scale": { "type": "number", "minimum": 0.5, "maximum": 0.92 },
                "size": { "type": "integer" }
              }
            },
            "tray": {
              "type": "object",
              "properties": {
                "mark_only": { "type": "boolean" },
                "mark_fill": { "type": "string" },
                "surface": { "type": "string" },
                "size": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "included_apps": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "description": "Optional sibling APP ids (agentsam.app.json) to bundle with this desktop host. Empty/omitted = host-only. Validated against the APP registry."
    },
    "version": {
      "type": "string",
      "description": "Desktop shell version; prefer syncing from @inneranimalmedia/agentsam-sdk."
    },
    "brand_family": {
      "type": "string",
      "description": "Master brand family id (e.g. agentsam). See docs/brand/AGENT_SAM_ICON_GRAMMAR.md."
    },
    "product_mark_variant": {
      "type": "string",
      "description": "Product cue on the master mark (e.g. local-studio-portal)."
    },
    "identity_provider": {
      "type": "string",
      "enum": ["inneranimalmedia", "google", "github", "gcp", "email"]
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": { "type": "string" },
        "accent_color": { "type": "string" }
      }
    },
    "feature_flags": {
      "type": "object",
      "properties": {
        "tray": { "type": "boolean", "default": true },
        "auto_update": { "type": "boolean", "default": true },
        "local_execution_node": { "type": "boolean", "default": false }
      }
    }
  }
}
