{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSam Local Studio",
  "version": "2.6.5",
  "identifier": "com.inneranimalmedia.local-studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentSam Local Studio",
        "width": 1200,
        "height": 800,
        "url": "index.html"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentsamstudio"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMjI3OEI2RjZCQjA3RDEKUldUUkI3djJ0bmdpcnVNb1FFOXhqVWYyZm5mM2dwUTVDYVVlUS9TY3RwV3VaSFlYU2ZWSGhMbWgK",
      "endpoints": [
        "https://updates.agentsam.dev/updates/local-studio/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
