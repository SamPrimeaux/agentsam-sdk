{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSam Desktop Shell",
  "version": "0.1.0",
  "identifier": "com.inneranimalmedia.desktop-shell.dev",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentSam",
        "width": 1200,
        "height": 800
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png"
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["agentsam"]
      }
    }
  }
}
