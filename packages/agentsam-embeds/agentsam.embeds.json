    {
      "key": "store_chat",
      "registry_required": true,
      "name": "Online store chat",
      "icon": "chat",
      "tagline": "Chat icon and popup that lands conversations in the site inbox.",
      "category": "Inbox",
      "capabilities": [
        "inbox.thread.create",
        "inbox.message.create"
      ],
      "surfaces": [
        "storefront_embed"
      ],
