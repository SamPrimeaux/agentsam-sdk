{
  "schema": "agentsam.app.v1",
  "id": "embeds",
  "name": "Storefront embeds",
  "role": "embed-pack",
  "category": "storefront",
  "status": "bundled",
  "provides": [
    "form.submit",
    "inbox.thread.create",
    "inbox.message.create",
    "campaign.attribution.write"
  ],
  "implementation": {
    "frontend": [
      "src/chat-widget.js",
      "src/form-widget.js",
      "src/customer-account-portal.js"
    ],
    "backend": []
  },
  "storefront_embeds": [
    {
      "key": "form_inline",
      "name": "Form",
      "icon": "mail",
      "tagline": "Inline form with editable fields, consent and submission inbox.",
      "category": "Forms",
      "capabilities": [
        "form.submit",
        "inbox.thread.create"
      ],
      "surfaces": [
        "storefront_embed",
        "cms_block"
      ],
      "permissions": [
        "Store submitted details in the site inbox"
      ],
      "default_config": {
        "enabled": false,
        "accent": "",
        "background": "",
        "font_color": "",
        "invert_colors": false,
        "inherit_typography": true,
        "font_size": 16,
        "border_radius": 16,
        "placement": "inline",
        "trigger": "manual",
        "heading": "Get in touch",
        "subtitle": "Send us a note.",
        "button_label": "Send message",
        "required_fields": [
          "email"
        ],
        "fields": [
          "first_name",
          "email",
          "message"
        ],
        "success_message": "Thanks, we will reply soon.",
        "delay_ms": 0
      },
      "editor_fields": [
        {
          "key": "heading",
          "label": "Heading",
          "type": "text"
        },
        {
          "key": "subtitle",
          "label": "Subtitle",
          "type": "text"
        },
        {
          "key": "button_label",
          "label": "Button label",
          "type": "text"
        },
        {
          "key": "fields",
          "label": "Fields",
          "type": "multiselect",
          "options": [
            "first_name",
            "last_name",
            "email",
            "phone",
            "message"
          ]
        },
        {
          "key": "required_fields",
          "label": "Required fields",
          "type": "multiselect",
          "options": [
            "first_name",
            "last_name",
            "email",
            "phone",
            "message"
          ]
        },
        {
          "key": "success_message",
          "label": "Success message",
          "type": "textarea"
        },
        {
          "key": "accent",
          "label": "Accent",
          "type": "color",
          "theme_token": true
        },
        {
          "key": "background",
          "label": "Background",
          "type": "color",
          "theme_token": true
        },
        {
          "key": "font_color",
          "label": "Font color",
          "type": "color",
          "theme_token": true
        },
        {
          "key": "invert_colors",
          "label": "Invert widget colors",
          "type": "toggle"
        },
        {
          "key": "border_radius",
          "label": "Border radius",
          "type": "range",
          "min": 0,
          "max": 32,
          "unit": "px"
        }
      ]
    },
