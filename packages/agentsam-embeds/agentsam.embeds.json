        {
          "key": "fields",
          "label": "Fields",
          "type": "multiselect",
          "options": [
            "first_name",
            "last_name",
            "email",
            "phone",
            "message"
          ]
        },
        {
          "key": "required_fields",
          "label": "Required fields",
          "type": "multiselect",
          "options": [
            "first_name",
            "last_name",
            "email",
            "phone",
            "message"
          ]
