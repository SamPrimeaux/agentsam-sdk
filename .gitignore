# Allow package-local feature packets (identity, etc.)
!packages/**/.agentsam/
!packages/**/.agentsam/**
generated/
# Canonical checked-in registry inventory; unlike build output it is CI evidence.
!src/registry/generated/
!src/registry/generated/inventory.json
work/

# Generated theme gallery mounts (scripts/stage-themes-to-site.mjs via site:sync)
apps/frontend/public/site/themes/
apps/local-studio/frontend/public/site/themes/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
.agentsam/local-runtime.json

# Package build outputs
packages/*/dist/
examples/*/dist/
examples/*/.vite/
apps/local-studio/desktop-dist/

# Editor recovery files
*.swp

# AgentSam Go runtime build provenance (generated by canonical build/deploy path)
apps/agentsam-go-worker/runtime/.agentsam-build-*
apps/agentsam-go-worker/runtime/.agentsam-built-*
apps/agentsam-go-worker/runtime/.agentsam-build-source

# Local content host grant registry (opaque handle persistence)
.agentsam/content-grants.json

# Rebuildable AgentSam Machine perception/cache
.agentsam/machine/

# Generated native Machine receipts from nested workspaces
**/.agentsam/machine/

# Per-repository media choice and local asset objects
.agentsam/media/

# Per-worktree SAM gap build logs and machine-local receipts
.sam-gap-build/

# Agent evidence captures may contain private source data
.agentsam/evidence/
# Generated CAD Creator offline schema bundle (canonical source: protocol/cad/v2/)
/apps/cad-creator/schemas/

# Generated host assets are assembled from the Ecommerce package; only host-config.js is source.
/apps/local-studio/frontend/public/admin/*
!/apps/local-studio/frontend/public/admin/host-config.js

# Generated PrimeTech CAD/CAM design-review artifacts; not source
/.agentsam/artifacts/cam/

# Generated Local Studio compiled theme previews (source stays in packages/)
apps/local-studio/frontend/public/themes/
