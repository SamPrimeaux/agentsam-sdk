{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentsam-sdk",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "AGENTSAM_WORKER_ROLE": "sdk-control-plane",
    "IAM_ORIGIN": "https://inneranimalmedia.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inneranimalmedia-business",
      "database_id": "cf87b717-d4e2-4cf8-bab0-a81268e32d49"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WEBSITE_ASSETS",
      "bucket_name": "agentsam-os-blueprint-content"
    }
  ],
  "ai": {
    "binding": "AGENTSAM_WAI"
  }
}
