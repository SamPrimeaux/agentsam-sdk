{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/plugin-quality-receipt/v1",
  "title": "AgentSam Plugin Quality Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plugin",
    "generatedAt",
    "findings",
    "checks",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "agentsam.plugin-quality-receipt/v1"
    },
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "code",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "receipt": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "READY",
        "NOT_READY"
      ]
    }
  }
}
