{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/plugin-product/v1",
  "title": "AgentSam Plugin Product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "ownership",
    "capabilities",
    "permissions",
    "auth",
    "health",
    "lifecycle",
    "verification",
    "release"
  ],
  "properties": {
    "schema": {
      "const": "agentsam.plugin-product/v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "publisher"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainPackage",
        "owns",
        "platformAuthorities"
      ],
      "properties": {
        "domainPackage": {
          "type": "string",
          "minLength": 1
        },
        "owns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "platformAuthorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "read",
              "write",
              "destructive"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared"
      ],
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "connectionRequired"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "oauth",
            "credential",
            "host"
          ]
        },
        "connectionRequired": {
          "type": "boolean"
        },
        "resource": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "strategy"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states"
      ],
      "properties": {
        "states": {
          "const": [
            "available",
            "installed",
            "needs_connection",
            "connected",
            "ready"
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredChecks"
      ],
      "properties": {
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptRequired"
      ],
      "properties": {
        "receiptRequired": {
          "const": true
        }
      }
    }
  }
}
