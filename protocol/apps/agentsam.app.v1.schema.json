{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsam.inneranimalmedia.com/protocol/apps/agentsam.app.v1.schema.json",
  "title": "agentsam.app.v1",
  "description": "Installable AgentSam product APP. Canonical identity is id (kebab-case). Package, Worker, route, desktop, and service names live in other namespaces.",
  "type": "object",
  "required": ["schema", "id", "name", "kind"],
  "properties": {
    "schema": { "const": "agentsam.app.v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 2,
      "description": "Immutable APP.id — short kebab-case product identity (not Worker/npm/route name)"
    },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "const": "app" },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Optional platform PRODUCT registry id when it differs from APP.id"
    },
    "package": {
      "type": "string",
      "description": "npm package name (PACKAGE namespace) — must not be used as APP.id"
    },
    "version": { "type": "string" },
    "entrypoints": {
      "type": "object",
      "properties": {
        "frontend": { "type": "string" },
        "backend": { "type": "string" },
        "cli": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "capabilities": {
      "description": "Capability tokens this APP provides (array) or legacy boolean map",
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      ]
    },
    "provides": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bin": { "type": "string" },
    "commands": { "type": "object", "additionalProperties": { "type": "string" } },
    "surfaces": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "object" }
      ]
    },
    "routes": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "description": "Authenticated entry path after login when no return_to exists",
          "pattern": "^/"
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "auth": { "enum": ["required", "optional", "public"], "default": "public" },
              "spa": { "type": "boolean" },
              "shell": {
                "type": "string",
                "description": "Build artifact relative to assetRoot (must exist after build)"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "type": { "enum": ["spa", "ssr", "static"] },
        "assetRoot": { "type": "string" },
        "shell": { "type": "string" },
        "browser": { "type": ["boolean", "string"] },
        "local": { "type": ["boolean", "string"] },
        "cloudflare": { "type": ["boolean", "string"] }
      },
      "additionalProperties": true
    },
    "preview": { "type": "object", "additionalProperties": true },
    "install": { "type": "object", "additionalProperties": true },
    "auth": { "type": "object", "additionalProperties": true },
    "secrets": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
