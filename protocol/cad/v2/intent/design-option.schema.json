{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/intent/design-option.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable CAD v2 versioned optional strict module; semantic and kernel validation are separate requirements.",
  "properties": {
    "authorId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "baseRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "comparisonReceiptIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "operationIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "overrides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^/",
            "type": "string"
          },
          "targetId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "targetId",
          "path",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "rejected",
        "merged"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "baseRevision",
    "operationIds",
    "overrides",
    "status"
  ],
  "title": "Non-destructive design alternative and revision branch",
  "type": "object"
}
