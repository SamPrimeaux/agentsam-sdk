{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/core/artifact-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "mediaType": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "bytes",
        "mediaType"
      ],
      "type": "object"
    },
    "executor": {
      "additionalProperties": false,
      "properties": {
        "lane": {
          "enum": [
            "local_device",
            "vm",
            "sandbox",
            "worker"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "lane"
      ],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "operationId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "outputId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "reviewRequired": {
      "type": "boolean"
    },
    "sourceRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "generated",
        "validated",
        "failed",
        "rejected",
        "stale"
      ]
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "validationIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "outputId",
    "projectId",
    "sourceRevision",
    "operationId",
    "artifact",
    "executor",
    "status",
    "timestamp"
  ],
  "title": "Generated output with correlated execution evidence",
  "type": "object"
}
