{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/core/project-revision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "agent",
            "system"
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "changedEntityIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "index": {
      "minimum": 1,
      "type": "integer"
    },
    "lockedIntentIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "operationIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "parentIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "receiptIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sourceHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "state": {
      "enum": [
        "draft",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "index",
    "parentIds",
    "timestamp",
    "actor",
    "sourceHash",
    "operationIds",
    "state"
  ],
  "title": "Immutable source revision and provenance",
  "type": "object"
}
