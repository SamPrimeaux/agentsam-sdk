{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/v2/core/topology-reference.schema.json",
  "title": "Stable topology face edge and vertex reference",
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entityId",
    "kind",
    "persistentName",
    "regenerationPolicy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "representationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kind": {
      "enum": [
        "vertex",
        "edge",
        "wire",
        "face",
        "shell",
        "solid"
      ]
    },
    "persistentName": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticRole": {
      "type": "string",
      "minLength": 1
    },
    "sourceFeatureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "regenerationPolicy": {
      "enum": [
        "preserve-if-matching",
        "remap-by-feature",
        "review-required"
      ]
    },
    "remappedFrom": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
