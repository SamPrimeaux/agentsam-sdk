{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/core/geometry-relationship.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "properties": {
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "contains",
        "aggregates",
        "hosts",
        "voids",
        "fills",
        "assigns-type",
        "system-membership",
        "connects",
        "constrains",
        "references",
        "realizes-feature"
      ]
    },
    "properties": {
      "additionalProperties": true,
      "type": "object"
    },
    "sourceIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sourceRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "targetIds": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "kind",
    "sourceIds",
    "targetIds"
  ],
  "title": "Typed CAD BIM semantic relation",
  "type": "object"
}
