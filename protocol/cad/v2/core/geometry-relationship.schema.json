{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/v2/core/geometry-relationship.schema.json",
  "title": "Typed CAD BIM semantic relation",
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "sourceIds",
    "targetIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "kind": {
      "enum": [
        "contains",
        "aggregates",
        "hosts",
        "voids",
        "fills",
        "assigns-type",
        "system-membership",
        "connects",
        "constrains",
        "references",
        "realizes-feature"
      ]
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
