{
  "$comment": "Opt-in strict entity contract; do not insert these fields into legacy v2 geometry.entities until a lossless migration exists.",
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/core/geometry-entity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "AgentSam CAD v2 opt-in strict modular contract; requires independent reference and native-geometry validation.",
  "properties": {
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "externalIds": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "featureId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "kind": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "placement": {
      "$ref": "./coordinate-system.schema.json#/$defs/placement"
    },
    "properties": {
      "additionalProperties": true,
      "type": "object"
    },
    "representationRefs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sourceRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "topologyRefs": {
      "items": {
        "$ref": "./topology-reference.schema.json"
      },
      "type": "array"
    },
    "typeId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "title": "Persistent editable geometry element",
  "type": "object"
}
