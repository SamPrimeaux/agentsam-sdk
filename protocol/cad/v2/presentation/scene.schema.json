{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/presentation/scene.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable CAD v2 versioned optional strict module; semantic and kernel validation are separate requirements.",
  "properties": {
    "cameras": {
      "items": {
        "$ref": "./view.schema.json"
      },
      "type": "array"
    },
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "minLength": 1,
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "northRotation": {
          "type": "number"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "geometryAssetRefs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "lights": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "intensity": {
            "minimum": 0,
            "type": "number"
          },
          "kind": {
            "enum": [
              "area",
              "point",
              "spot",
              "sun",
              "environment"
            ]
          },
          "position": {
            "items": false,
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "unit": {
            "enum": [
              "lux",
              "lumens",
              "watts",
              "relative"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "intensity",
          "unit"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "materials": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assetRef": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "objectMappings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entityId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "materialId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "representationId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "sceneObjectId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "entityId",
          "representationId",
          "sceneObjectId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "projectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "sourceRevision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "projectId",
    "sourceRevision",
    "objectMappings",
    "materials",
    "lights"
  ],
  "title": "Revision-addressed model-derived presentation scene",
  "type": "object"
}
