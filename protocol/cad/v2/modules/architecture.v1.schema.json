{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/modules/architecture.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable CAD v2 versioned optional strict module; semantic and kernel validation are separate requirements.",
  "properties": {
    "buildings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "siteId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "storeyIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "siteId",
          "name",
          "storeyIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "classificationRefs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "idsRequirementRefs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "relationships": {
      "items": {
        "$ref": "../core/geometry-relationship.schema.json"
      },
      "type": "array"
    },
    "schema": {
      "const": "cad.module.architecture.v1"
    },
    "sites": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "buildingIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "frameId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "frameId",
          "buildingIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "spaces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "boundaryElementIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "classificationRefs": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "storeyId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "storeyId",
          "name",
          "boundaryElementIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "storeys": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "buildingId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "elementIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "elevation": {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in",
                  "ft",
                  "deg",
                  "rad",
                  "kg",
                  "g",
                  "N",
                  "kN",
                  "Pa",
                  "MPa",
                  "s"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "type": "object"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "spaceIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "buildingId",
          "name",
          "elevation",
          "elementIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "systems": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "elementIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "structural",
              "mechanical",
              "electrical",
              "plumbing",
              "fire",
              "envelope",
              "civil"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "elementIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "version",
    "sites",
    "buildings",
    "storeys",
    "spaces",
    "relationships"
  ],
  "title": "Semantic BIM spatial hierarchy",
  "type": "object"
}
