{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/modules/landscape.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable CAD v2 versioned optional strict module; semantic and kernel validation are separate requirements.",
  "properties": {
    "drainage": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "elementIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "swale",
              "catch-basin",
              "pipe",
              "grade-break",
              "retention"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "elementIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "georeferenceFrameId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "type": "string"
    },
    "hardscape": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entityIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "materialId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "entityIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "cad.module.landscape.v1"
    },
    "terrain": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "frameId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "representationRef": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "surveySourceId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "representationRef",
          "frameId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "vegetation": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "placement": {
            "$ref": "../core/coordinate-system.schema.json#/$defs/placement"
          },
          "quantity": {
            "minimum": 0,
            "type": "integer"
          },
          "speciesRef": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "speciesRef",
          "placement"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "version",
    "terrain",
    "vegetation",
    "hardscape",
    "drainage"
  ],
  "title": "Landscape terrain and site coordination",
  "type": "object"
}
