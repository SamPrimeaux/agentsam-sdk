{
  "$id": "https://schemas.inneranimalmedia.com/apps/cad-creator/schemas/releases/2.6.13-modules.2/v2/modules/mechanical.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Portable CAD v2 versioned optional strict module; semantic and kernel validation are separate requirements.",
  "properties": {
    "assemblies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "componentIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "frameId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "mateIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "componentIds",
          "frameId",
          "mateIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "joints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "axis": {
            "items": false,
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "revolute",
              "prismatic",
              "fixed",
              "spherical",
              "planar",
              "six-dof"
            ]
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "maximum": {
                "type": "number"
              },
              "minimum": {
                "type": "number"
              },
              "unit": {
                "enum": [
                  "mm",
                  "deg",
                  "rad"
                ]
              }
            },
            "required": [
              "minimum",
              "maximum",
              "unit"
            ],
            "type": "object"
          },
          "sourceId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "targetId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "sourceId",
          "targetId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "parts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entityIds": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "mass": {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in",
                  "ft",
                  "deg",
                  "rad",
                  "kg",
                  "g",
                  "N",
                  "kN",
                  "Pa",
                  "MPa",
                  "s"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "type": "object"
          },
          "materialId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "profileId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "entityIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "cad.module.mechanical.v1"
    },
    "tolerances": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "featureId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "minus": {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in",
                  "ft",
                  "deg",
                  "rad",
                  "kg",
                  "g",
                  "N",
                  "kN",
                  "Pa",
                  "MPa",
                  "s"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "type": "object"
          },
          "nominal": {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in",
                  "ft",
                  "deg",
                  "rad",
                  "kg",
                  "g",
                  "N",
                  "kN",
                  "Pa",
                  "MPa",
                  "s"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "type": "object"
          },
          "plus": {
            "additionalProperties": false,
            "properties": {
              "unit": {
                "enum": [
                  "mm",
                  "cm",
                  "m",
                  "in",
                  "ft",
                  "deg",
                  "rad",
                  "kg",
                  "g",
                  "N",
                  "kN",
                  "Pa",
                  "MPa",
                  "s"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "featureId",
          "nominal"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "version",
    "parts",
    "assemblies",
    "joints"
  ],
  "title": "Mechanical parts assemblies and kinematics",
  "type": "object"
}
