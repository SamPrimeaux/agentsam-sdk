{
  "schema_version": 1,
  "presets": {
    "fullstack": {
      "id": "fullstack",
      "version": 1,
      "lane": "fullstack",
      "description": "Local-first application with AgentSam runtime, repository primitives, knowledge, and delivery hooks.",
      "features": [
        "agent",
        "knowledge"
      ],
      "capabilities": [
        "scaffold.create",
        "repository.snapshot",
        "knowledge.index",
        "knowledge.search",
        "security.scan",
        "deploy.receipt"
      ],
      "defaults": {
        "database": "sqlite",
        "assets": "local",
        "deploy": "local"
      }
    },
    "cms": {
      "id": "cms",
      "version": 2,
      "lane": "cms",
      "description": "Content-oriented application with AgentSam CMS editor, stock heuristic-theme, and explicit auth/deploy opt-ins.",
      "features": [
        "cms",
        "knowledge",
        "brand",
        "theme"
      ],
      "capabilities": [
        "scaffold.create",
        "repository.snapshot",
        "knowledge.index",
        "knowledge.search",
        "site.scrape",
        "deploy.receipt",
        "brand.scan",
        "brand.resolve",
        "theme.storefront.shell"
      ],
      "defaults": {
        "database": "sqlite",
        "assets": "local",
        "deploy": "local",
        "theme": "heuristic-theme",
        "composer": "agentsam.mini-composer"
      },
      "packages": {
        "theme": "@inneranimalmedia/heuristic-theme",
        "composer": "@inneranimalmedia/agentsam-workbench",
        "analytics": "@inneranimalmedia/commerce-analytics"
      },
      "notes": "Fuel & Free Time hosts proving-ground copies; SDK packages are the publish targets."
    },
    "prototype": {
      "id": "prototype",
      "version": 1,
      "lane": "fullstack",
      "description": "Small local prototype with the minimum deterministic AgentSam runtime.",
      "features": [
        "agent"
      ],
      "capabilities": [
        "scaffold.create",
        "repository.snapshot",
        "security.scan"
      ],
      "defaults": {
        "database": "sqlite",
        "assets": "local",
        "deploy": "local"
      }
    },
    "data": {
      "id": "data",
      "version": 1,
      "lane": "data",
      "description": "Data-oriented local application with repository knowledge and explicit production storage graduation.",
      "features": [
        "knowledge"
      ],
      "capabilities": [
        "scaffold.create",
        "repository.snapshot",
        "knowledge.index",
        "knowledge.search",
        "security.scan"
      ],
      "defaults": {
        "database": "sqlite",
        "assets": "local",
        "deploy": "local"
      }
    }
  },
  "addons": {
    "agent": {
      "id": "agent",
      "capabilities": [
        "scaffold.create"
      ],
      "description": "AgentSam local runtime selection."
    },
    "auth": {
      "id": "auth",
      "capabilities": [
        "identity.init"
      ],
      "description": "Identity selection (schema_version 2). Records provider_template; use `agentsam identity plan|init|schema` for protocol-driven setup."
    },
    "cms": {
      "id": "cms",
      "capabilities": [
        "site.scrape"
      ],
      "description": "CMS/content feature selection (stock theme: heuristic-theme via theme.storefront.shell)."
    },
    "theme": {
      "id": "theme",
      "capabilities": [
        "theme.storefront.shell"
      ],
      "description": "Stock storefront theme selection — default package @inneranimalmedia/heuristic-theme (theme.storefront.shell). Theme is a projection of Brand, not brand authority."
    },
    "brand": {
      "id": "brand",
      "capabilities": [
        "brand.scan",
        "brand.resolve"
      ],
      "description": "Deterministic Brand Intelligence — evidence from repository.snapshot; Brand ≠ Theme."
    },
    "knowledge": {
      "id": "knowledge",
      "capabilities": [
        "knowledge.index",
        "knowledge.search"
      ],
      "description": "Portable repository indexing and retrieval."
    },
    "deploy-cloudflare": {
      "id": "deploy-cloudflare",
      "capabilities": [
        "deploy.receipt"
      ],
      "description": "Select Cloudflare as the intended deploy target; provisioning remains explicit at deploy time."
    }
  }
}
