{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentsam.theme-refinery.product-metadata.v1",
  "title": "agentsam_products.metadata for theme-refinery provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "origin": { "type": "string", "enum": ["machine_harvest", "gallery_mount", "manual", "apps_backfill"] },
    "donor_name": { "type": "string" },
    "source_path": { "type": "string", "description": "Local donor path; never secrets" },
    "harvest_batch": { "type": "string" },
    "normalization_state": {
      "type": "string",
      "enum": ["fingerprinted", "portable", "portable-preview", "normalized", "wired", "promoted"]
    },
    "source_hash": { "type": "string" },
    "app_manifest": { "type": "string" },
    "help_root": { "type": "string" },
    "preview_kind": { "type": "string", "enum": ["static", "live", "iframe", "none"] },
    "package": { "type": "string" },
    "gallery_path": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "latest_evidence_snapshot_id": { "type": ["string", "null"] },
    "latest_quality_report_id": { "type": ["string", "null"] }
  },
  "required": ["origin", "normalization_state"]
}
