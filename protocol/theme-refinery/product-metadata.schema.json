{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/theme-refinery/product-metadata.schema.json",
  "title": "agentsam_products.metadata for portable prebuild packages",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "origin": {
      "type": "string",
      "enum": [
        "package_prebuild",
        "manual",
        "apps_backfill"
      ]
    },
    "build_batch": {
      "type": "string"
    },
    "normalization_state": {
      "type": "string",
      "enum": [
        "normalized",
        "remastered",
        "package_ready",
        "wired",
        "promoted"
      ]
    },
    "family": {
      "type": "string",
      "description": "Generic reusable prebuild family."
    },
    "source_hash": {
      "type": "string",
      "description": "Content fingerprint only; never a customer path or identity."
    },
    "app_manifest": {
      "type": "string"
    },
    "help_root": {
      "type": "string"
    },
    "preview_kind": {
      "type": "string",
      "enum": [
        "static",
        "live",
        "iframe",
        "none"
      ]
    },
    "package": {
      "type": "string"
    },
    "prebuild_root": {
      "type": "string"
    },
    "portable": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latest_evidence_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_quality_report_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "origin",
    "normalization_state"
  ]
}
