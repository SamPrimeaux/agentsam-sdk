{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/hooks/agentsam.hook.receipt.v1.schema.json",
  "title": "AgentSam hook execution receipt",
  "type": "object",
  "required": ["schema", "hook_id", "hook", "status", "started_at", "completed_at", "duration_ms", "input_keys", "output_keys"],
  "properties": {
    "schema": { "const": "agentsam.hook.receipt.v1" },
    "hook_id": { "type": "string", "minLength": 1 },
    "hook": {
      "enum": [
        "session_start", "session_end", "user_prompt_submitted", "user_prompt_transformed",
        "pre_model_use", "post_model_use", "pre_tool_use", "post_tool_use",
        "post_tool_use_failure", "error_occurred", "agent_stop", "subagent_start", "subagent_stop"
      ]
    },
    "invocation": { "type": "object" },
    "status": { "enum": ["completed", "failed"] },
    "started_at": { "type": "number", "minimum": 0 },
    "completed_at": { "type": "number", "minimum": 0 },
    "duration_ms": { "type": "number", "minimum": 0 },
    "input_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "output_keys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "error": {
      "type": "object",
      "required": [
        "error_code", "reason", "domain", "failure_class", "stage", "feature",
        "failure_behavior", "retryable", "side_effect_state", "adapter", "protocol",
        "transport", "fingerprint", "message"
      ],
      "properties": {
        "error_code": { "type": "string", "pattern": "^[A-Z][A-Z_]{1,63}$" },
        "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "domain": { "type": "string", "minLength": 1 },
        "failure_class": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "failure_behavior": { "enum": ["fail_closed", "fail_open", "observe_only", "retry_bounded", "skip", "abort", "no_replay"] },
        "retryable": { "type": "boolean" },
        "side_effect_state": { "enum": ["none", "not_started", "confirmed_not_applied", "confirmed_applied", "partially_applied", "unknown"] },
        "adapter": { "type": ["string", "null"] },
        "protocol": { "type": ["string", "null"] },
        "transport": { "type": ["string", "null"] },
        "fingerprint": { "type": "string", "pattern": "^err_[A-Za-z0-9_-]{8,128}$" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "native_evidence": {
      "type": "object",
      "required": ["code", "exception_type", "message"],
      "properties": {
        "code": { "type": ["string", "null"] },
        "exception_type": { "type": ["string", "null"] },
        "message": { "type": "string", "maxLength": 512 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
