{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsam.dev/protocol/database/agentsam.schema-pack.v1.schema.json",
  "title": "AgentSam schema pack family manifest",
  "description": "Generic reusable contract for product schema packs (Identity, CMS, CAD, …). Packs own their manifests; this schema is protocol authority.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "id", "version", "components"],
  "properties": {
    "schema": { "const": "agentsam.schema-pack.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "pack_family": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "component_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "adapters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sql": {
      "type": "object",
      "properties": {
        "portable_dir": { "type": "string" },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "apply_order_fresh": {
          "type": "array",
          "items": { "type": "string" }
        },
        "apply_order_upgrade_v1_to_v2": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optional_after_core": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "table_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "seed_policy": { "type": "string" },
    "compatibility": { "type": "object" },
    "recovery": { "type": "object" },
    "owner": { "type": "string" },
    "notes": { "type": "string" }
  }
}
