{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "description": "Runtime-owned project root."
    },
    "semantic": {
      "type": "boolean",
      "default": false
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "tokenBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32000
    },
    "generationId": {
      "type": "string"
    }
  }
}
