{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repository-mine-input",
  "type": "object",
  "required": [
    "root",
    "against"
  ],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "against": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  }
}
