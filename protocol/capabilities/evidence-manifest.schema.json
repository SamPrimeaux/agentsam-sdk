{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/capabilities/evidence-manifest.schema.json",
  "title": "AgentSamEvidence run manifest",
  "description": "Written last when a run is sealed; its presence is the completion marker. Status is computed from the tree, never hand-written. Keys are relative slug paths; ids appear only as fields.",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "subject",
    "project",
    "startedAt",
    "sealedAt",
    "status",
    "reasons",
    "flows",
    "checks",
    "missing",
    "errors",
    "noncanonical",
    "assets",
    "derivatives",
    "final",
    "handoff",
    "answers"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agentsam.evidence.v1"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}--\\d{8}--[a-f0-9]{7}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "slug"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sealedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "verified",
        "degraded",
        "failed"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(mobile|tablet|desktop)-\\d{3,4}x\\d{3,4}$"
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "flow",
          "name",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "flow": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]{0,47}$"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "step",
                "states"
              ],
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]{0,47}$"
                },
                "states": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "state",
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "state": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 999
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Za-z0-9]{0,47}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_reported"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{2,3}-\\d{2,3}-\\d{2,3}(@(mobile|tablet|desktop)-\\d{3,4}x\\d{3,4})?$"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stateId",
          "error",
          "at"
        ]
      }
    },
    "noncanonical": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "key",
          "file",
          "phase",
          "kind",
          "contentType",
          "bytes",
          "sha256",
          "capturedAt"
        ],
        "properties": {
          "schema": {
            "const": "agentsam.evidence.capture.v1"
          },
          "key": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "phase": {
            "enum": [
              "01-Brief",
              "02-Recon",
              "04-Build"
            ]
          },
          "stateId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{2,3}-\\d{2,3}-\\d{2,3}$"
          },
          "viewport": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(mobile|tablet|desktop)-\\d{3,4}x\\d{3,4}$"
          },
          "variant": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "still",
              "clip",
              "trace",
              "log",
              "diff",
              "doc"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "meta": {
            "type": "object"
          },
          "media": {
            "type": "object"
          }
        }
      }
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "bytes",
          "sha256"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "of": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "final": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "of",
          "sha256"
        ]
      }
    },
    "handoff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "bytes",
          "sha256"
        ]
      }
    },
    "facts": {
      "type": "object",
      "required": [
        "key",
        "sha256"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "key"
      ]
    },
    "answers": {
      "type": "object",
      "required": [
        "daysOfWork",
        "capturedPerDate",
        "declaredStates",
        "capturedStates",
        "missingStates"
      ],
      "properties": {
        "daysOfWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capturedPerDate": {
          "type": "object"
        },
        "declaredStates": {
          "type": "integer"
        },
        "capturedStates": {
          "type": "integer"
        },
        "missingStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
