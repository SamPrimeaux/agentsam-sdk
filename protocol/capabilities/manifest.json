{
  "schema_version": 1,
  "package": "@inneranimalmedia/agentsam-sdk",
  "capabilities": {
    "repository.snapshot": {
      "id": "repository.snapshot",
      "kind": "capability",
      "version": 1,
      "domain": "repository",
      "runtime": "node+python",
      "package": "@inneranimalmedia/agentsam-sdk/repository",
      "export": "repositorySnapshot",
      "cli": "agentsam inspect --json",
      "description": "Collect a read-only, content-addressed repository evidence snapshot.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "input_schema": "protocol/capabilities/repository-snapshot-input.schema.json",
      "output_schema": "protocol/capabilities/repository-snapshot.schema.json",
      "status": "stable"
    },
    "repository.audit": {
      "id": "repository.audit",
      "kind": "agent_primitive",
      "version": 1,
      "domain": "repository",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/agent",
      "export": "runRepositoryAudit",
      "description": "Analyze a certified repository snapshot through an injected reasoning adapter without granting mutation authority.",
      "deterministic": false,
      "model_required": true,
      "side_effects": "none",
      "input_schema": "protocol/capabilities/repository-audit-input.schema.json",
      "output_schema": "protocol/capabilities/repository-audit.schema.json",
      "status": "stable"
    },
    "repository.intelligence": {
      "id": "repository.intelligence",
      "kind": "capability",
      "version": 1,
      "domain": "repository",
      "runtime": "python",
      "package": "@inneranimalmedia/agentsam-sdk/repository",
      "cli": "agentsam repo snapshot",
      "description": "Observe repository composition, manifests, churn, pressure, and stability.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "stable"
    },
    "knowledge.index": {
      "id": "knowledge.index",
      "kind": "capability",
      "version": 1,
      "domain": "repository",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/knowledge",
      "cli": "agentsam index run",
      "description": "Build the SDK local/portable coherent incremental structural/text generation with optional embeddings.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "local-state",
      "status": "stable"
    },
    "knowledge.search": {
      "id": "knowledge.search",
      "kind": "capability",
      "version": 1,
      "domain": "repository",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/knowledge",
      "cli": "agentsam search \"query\"",
      "description": "Retrieve bounded repository context from the SDK local/portable published knowledge generation.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "stable",
      "input_schema": "protocol/capabilities/knowledge-search-input.schema.json"
    },
    "merkle.snapshot": {
      "id": "merkle.snapshot",
      "kind": "capability",
      "version": 1,
      "domain": "integrity",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/merkle",
      "cli": "agentsam merkle snapshot",
      "description": "Create a portable SHA-256 filesystem snapshot.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "local-state",
      "status": "stable"
    },
    "deploy.receipt": {
      "id": "deploy.receipt",
      "kind": "capability",
      "version": 1,
      "domain": "delivery",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/deploy-receipt",
      "cli": "agentsam deploy-receipt capture",
      "description": "Capture and finalize content-addressed deployment evidence.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "local-state",
      "status": "stable"
    },
    "security.scan": {
      "id": "security.scan",
      "kind": "capability",
      "version": 1,
      "domain": "security",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/security",
      "cli": "agentsam security scan",
      "description": "Scan dependency vulnerability evidence and Merkle-bound AST execution trust boundaries; return deterministic contradiction and repair evidence.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "network-optional",
      "status": "stable"
    },
    "brand.scan": {
      "id": "brand.scan",
      "kind": "capability",
      "version": 1,
      "domain": "brand",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/brand",
      "export": "brandScan",
      "cli": "agentsam brand scan",
      "description": "Deterministically extract brand/visual evidence from the same repository.snapshot file authority (colors, tokens, components, assets).",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "produces": ["brand.evidence"],
      "status": "stable"
    },
    "brand.resolve": {
      "id": "brand.resolve",
      "kind": "capability",
      "version": 1,
      "domain": "brand",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/brand",
      "export": "brandResolve",
      "cli": "agentsam brand resolve",
      "description": "Cluster observed brand evidence into inferred roles with confidence; never mutates the repository.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "produces": ["brand.resolved"],
      "status": "stable"
    },
    "brand.plan": {
      "id": "brand.plan",
      "kind": "capability",
      "version": 1,
      "domain": "brand",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/brand",
      "export": "brandPlan",
      "cli": "agentsam plan brand",
      "description": "Produce a preserve→normalize→migrate brand coherence plan; optional --goap sequencing.",
      "deterministic": true,
      "model_required": false,
      "model_assisted_optional": true,
      "side_effects": "none",
      "status": "stable"
    },
    "identity.init": {
      "id": "identity.init",
      "kind": "capability",
      "version": 1,
      "domain": "app",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/identity",
      "cli": "agentsam identity init",
      "description": "Generate portable identity/auth application surfaces from SDK contracts.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "filesystem",
      "status": "stable"
    },
    "scaffold.create": {
      "id": "scaffold.create",
      "kind": "capability",
      "version": 1,
      "domain": "app",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk",
      "cli": "agentsam create <name> --preset <preset>",
      "description": "Create a local-first project from a deterministic preset selection.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "filesystem",
      "status": "stable"
    },
    "recon.pack": {
      "id": "recon.pack",
      "kind": "capability",
      "version": 1,
      "domain": "agent",
      "runtime": "node+python",
      "package": "@inneranimalmedia/agentsam-sdk/repository",
      "cli": "agentsam recon pack",
      "description": "Convert explicit evidence slices into bounded worker task packets.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "stable"
    },
    "site.scrape": {
      "id": "site.scrape",
      "kind": "capability",
      "version": 1,
      "domain": "web",
      "runtime": "python",
      "package": "agentsam-site-scrape",
      "cli": "python -m agentsam_site_scrape",
      "description": "Crawl a bounded public site and prepare page/image assets for local or R2 ingest.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "network+filesystem",
      "status": "stable"
    },
    "blender.status": {
      "id": "blender.status",
      "kind": "capability",
      "version": 1,
      "domain": "cad",
      "runtime": "node+blender",
      "package": "@inneranimalmedia/agentsam-sdk/cad",
      "export": "blenderStatus",
      "cli": "agentsam cad blender status --json",
      "description": "Discover an already-installed native Blender runtime and report its executable and version.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "blender.inspect": {
      "id": "blender.inspect",
      "kind": "capability",
      "version": 1,
      "domain": "cad",
      "runtime": "node+blender",
      "package": "@inneranimalmedia/agentsam-sdk/cad",
      "export": "blenderInspect",
      "cli": "agentsam cad blender inspect <model.blend> --json",
      "description": "Inspect a Blender scene headlessly without saving or mutating the source file.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "blender.build": {
      "id": "blender.build",
      "kind": "capability",
      "version": 1,
      "domain": "cad",
      "runtime": "node+blender",
      "package": "@inneranimalmedia/agentsam-sdk/cad",
      "export": "blenderBuild",
      "cli": "agentsam cad blender build <recipe.json> --out <model.blend> --json",
      "description": "Create or modify Blender geometry through a bounded declarative modeling recipe without arbitrary Python execution.",
      "deterministic": false,
      "model_required": false,
      "side_effects": "artifact-write",
      "input_schema": "protocol/cad/blender-recipe.schema.json",
      "status": "experimental"
    },
    "blender.render_preview": {
      "id": "blender.render_preview",
      "kind": "capability",
      "version": 1,
      "domain": "cad",
      "runtime": "node+blender",
      "package": "@inneranimalmedia/agentsam-sdk/cad",
      "export": "blenderRenderPreview",
      "cli": "agentsam cad blender render-preview <model.blend> --out <preview.png> --json",
      "description": "Render a bounded preview from an existing Blender scene and return a content hash receipt.",
      "deterministic": false,
      "model_required": false,
      "side_effects": "artifact-write",
      "status": "experimental"
    },
    "blender.export": {
      "id": "blender.export",
      "kind": "capability",
      "version": 1,
      "domain": "cad",
      "runtime": "node+blender",
      "package": "@inneranimalmedia/agentsam-sdk/cad",
      "export": "blenderExport",
      "cli": "agentsam cad blender export <model.blend> --format <glb|stl|obj> --out <artifact> --json",
      "description": "Export selected Blender scene content to GLB, STL, or OBJ with versioned SHA-256 artifact evidence.",
      "deterministic": false,
      "model_required": false,
      "side_effects": "artifact-write",
      "status": "experimental"
    },
    "tools.search": {
      "id": "tools.search",
      "kind": "capability",
      "version": 1,
      "domain": "agent",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/tools",
      "export": "searchToolCards",
      "description": "Discover compact capability cards without injecting the full tool catalog or full schemas.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "context.resolve": {
      "id": "context.resolve",
      "kind": "capability",
      "version": 1,
      "domain": "agent",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/context",
      "export": "resolveContext",
      "description": "Select bounded evidence against an explicit model-aware context budget and return a measurable receipt.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "output_schema": "protocol/context/resolved-context-pack.schema.json",
      "status": "experimental"
    },
    "terminal.exec": {
      "id": "terminal.exec",
      "kind": "capability",
      "version": 1,
      "domain": "terminal",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk",
      "export": "terminalExec",
      "description": "Run a real argv-safe CLI process inside the runtime-owned project, with bounded output, credential-stripped environment, and explicit execution approval.",
      "deterministic": false,
      "model_required": false,
      "side_effects": "local-runtime",
      "input_schema": "protocol/capabilities/terminal-exec-input.schema.json",
      "status": "experimental"
    },
    "cloudflare.wrangler.native": {
      "id": "cloudflare.wrangler.native",
      "kind": "capability",
      "version": 1,
      "domain": "cloudflare",
      "runtime": "node+wrangler",
      "package": "@inneranimalmedia/agentsam-sdk/cloudflare",
      "export": "runWranglerNative",
      "cli": "agentsam cloudflare run <command>",
      "description": "Execute one allowlisted read-only Wrangler operation with argv-safe cwd/config scoping and structured diagnostics.",
      "deterministic": false,
      "model_required": false,
      "side_effects": "network-read",
      "input_schema": "protocol/capabilities/cloudflare-wrangler-native-input.schema.json",
      "status": "experimental"
    },
    "cloudflare.cpu.profile": {
      "id": "cloudflare.cpu.profile",
      "kind": "capability",
      "version": 1,
      "domain": "cloudflare",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/cloudflare",
      "export": "summarizeCloudflareCpuProfileFile",
      "cli": "agentsam cloudflare cpu analyze <profile.cpuprofile>",
      "description": "Summarize a local workerd/DevTools CPU profile into bounded ranked self-time evidence.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "input_schema": "protocol/capabilities/cloudflare-cpu-profile-input.schema.json",
      "status": "experimental"
    },
    "cloudflare.cpu.audit": {
      "id": "cloudflare.cpu.audit",
      "kind": "agent_primitive",
      "version": 1,
      "domain": "cloudflare",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/cloudflare",
      "export": "runCloudflareCpuAudit",
      "description": "Analyze a bounded Cloudflare CPU profile and selected source evidence through an injected reasoning adapter without deploy authority.",
      "deterministic": false,
      "model_required": true,
      "side_effects": "none",
      "input_schema": "protocol/capabilities/cloudflare-cpu-audit-input.schema.json",
      "status": "experimental"
    },
    "workgraph.model": {
      "id": "workgraph.model",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph",
      "export": "WorkGraph",
      "description": "Core work-graph primitive (WorkItem, Dependency, TimelineEvent, Artifact, Evidence, Actor) that engineering and business adapters and timeline/Gantt renderers project onto. The graph is the source of truth; the timeline UI is a view over it, not its own state.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "workgraph.adapter.engineering": {
      "id": "workgraph.adapter.engineering",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph/adapters/engineering/git",
      "export": "createGitAdapter",
      "description": "Maps supplied git commits to work items without network access.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "workgraph.adapter.mcp": {
      "id": "workgraph.adapter.mcp",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph/adapters/engineering/mcp",
      "export": "createMcpAdapter",
      "description": "Maps supplied MCP tool call receipts to work items without network access.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "workgraph.adapter.business": {
      "id": "workgraph.adapter.business",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph/adapters/business/projects",
      "export": "createProjectsAdapter",
      "description": "Maps supplied project records to work items without network access.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "workgraph.render.timeline": {
      "id": "workgraph.render.timeline",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph/renderers/timeline",
      "export": "createTimelineModel",
      "description": "Renders a work graph into a timeline model (lanes by actor, work items per lane, timeline events) for a Gantt-style view. Pure projection \u2014 never a data source.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "workgraph.render.gantt_model": {
      "id": "workgraph.render.gantt_model",
      "kind": "capability",
      "version": 1,
      "domain": "workgraph",
      "runtime": "node",
      "package": "@inneranimalmedia/agentsam-sdk/work-graph/renderers/gantt-model",
      "export": "createGanttModel",
      "description": "Projects work items to a Gantt model; a reference HTML prototype is included separately.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    },
    "theme.storefront.shell": {
      "id": "theme.storefront.shell",
      "kind": "capability",
      "version": 1,
      "domain": "theme",
      "runtime": "node",
      "package": "@inneranimalmedia/heuristic-theme",
      "export": "createStorefrontShellTheme",
      "description": "Resolve the stock AgentSam CMS storefront shell theme contract.",
      "deterministic": true,
      "model_required": false,
      "side_effects": "none",
      "status": "experimental"
    }
  }
}
