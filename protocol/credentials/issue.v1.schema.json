{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsam.inneranimalmedia.com/protocol/credentials/issue.v1.schema.json",
  "title": "credentials.issue",
  "description": "Mint an AgentSam API credential (aak_*). Host stores hash only; secret returned once.",
  "type": "object",
  "required": ["operation", "input", "output"],
  "properties": {
    "operation": { "const": "credentials.issue" },
    "input": {
      "type": "object",
      "required": ["account_id", "name"],
      "properties": {
        "account_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Semantic capability scopes (e.g. repository:read, models:invoke)"
        },
        "environment": { "enum": ["development", "preview", "production"] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "client_type": { "enum": ["cli", "ci", "agent", "integration"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["credential_id", "prefix", "secret_once", "created_at"],
      "properties": {
        "credential_id": { "type": "string" },
        "prefix": { "type": "string" },
        "secret_once": { "type": "string", "description": "Plaintext shown once; never stored by host" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
