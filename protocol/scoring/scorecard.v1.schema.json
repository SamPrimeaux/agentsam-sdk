{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsam.inneranimalmedia.com/protocol/scoring/scorecard.v1.schema.json",
  "title": "AgentSamScoreCard",
  "description": "Versioned derived score view. Raw evidence remains SSOT; ScoreCards are recomputable. Independent score families — never one grand similarity_score.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "score",
    "confidence",
    "algorithm",
    "weightsVersion",
    "components",
    "penalties",
    "evidenceRefs",
    "computedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "theme-similarity",
        "brand-affinity",
        "template-similarity",
        "section-reuse",
        "token-consistency",
        "portability",
        "package-readiness",
        "drift",
        "confidence",
        "structural-similarity",
        "reuse"
      ]
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "algorithm": { "type": "string" },
    "weightsVersion": { "type": "string" },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["raw", "normalized", "weight", "contribution"],
        "properties": {
          "raw": { "type": "number" },
          "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "contribution": { "type": "number" }
        }
      }
    },
    "penalties": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "computedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
