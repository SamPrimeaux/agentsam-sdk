{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/knowledge/context-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "ContextPack",
  "required": [
    "query_id",
    "query",
    "hits",
    "estimated_tokens"
  ],
  "properties": {
    "query_id": {
      "type": "string"
    },
    "query": {
      "$ref": "./retrieval-query.schema.json"
    },
    "hits": {
      "type": "array",
      "items": {
        "$ref": "./retrieval-hit.schema.json"
      }
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "string"
    },
    "diagnostics": {
      "type": "object"
    }
  }
}
