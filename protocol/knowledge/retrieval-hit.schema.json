{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/knowledge/retrieval-hit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "RetrievalHit",
  "required": [
    "chunk_id",
    "content",
    "score",
    "lane"
  ],
  "properties": {
    "chunk_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "lane": {
      "type": "string"
    },
    "repository_full_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "line_start": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "line_end": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_authority": {
      "type": "string"
    },
    "stale": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  }
}
