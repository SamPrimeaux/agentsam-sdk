{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inneranimalmedia.com/agentsam/knowledge/index-config.schema.json",
  "title": "Portable index configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository_id", "workspace_id", "scope", "chunking", "embedding", "storage"],
  "properties": {
    "version": { "const": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["name", "include"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "chunking": {
      "type": "object", "additionalProperties": false, "required": ["max_chars"],
      "properties": { "max_chars": { "type": "integer", "minimum": 256, "maximum": 12000 } }
    },
    "embedding": {
      "type": "object", "additionalProperties": false, "required": ["provider", "model", "revision", "dimensions", "parameters"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 3072 },
        "parameters": { "type": "object", "description": "Non-secret provider-specific embedding options. Credentials are injected separately." }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["driver"],
      "properties": { "driver": { "enum": ["sqlite", "postgres"] }, "connection_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
      "allOf": [{ "if": { "properties": { "driver": { "const": "postgres" } } }, "then": { "required": ["connection_env"] } }]
    }
  }
}
