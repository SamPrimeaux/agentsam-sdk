{
  "schema_version": 2,
  "project": {
    "name": "agentsam-sdk"
  },
  "repository": {
    "id": "github:samprimeaux/agentsam-sdk",
    "remote": "origin"
  },
  "product": {
    "preset": null,
    "features": [],
    "capabilities": []
  },
  "defaults": {
    "mode": "agent",
    "profile": "default",
    "runtime": "local",
    "model": "auto",
    "deploy_target": "cloudflare"
  },
  "deployment": {
    "cloudflare": {
      "worker_name": "agentsam-sdk",
      "config": "apps/local-studio/backend/wrangler.jsonc",
      "health_url": "https://agentsam.inneranimalmedia.com/health"
    }
  },
  "merkle": {
    "enabled": true,
    "semantic": true,
    "persistence": "auto"
  },
  "knowledge": {
    "config": ".agentsam/knowledge.json"
  },
  "local": {
    "database": ".agentsam/data/agentsam.sqlite",
    "schema": "db/schema.sql"
  },
  "sdk": {
    "created_with": "2.5.0"
  },
  "rules": {
    "file": ".agentsamrules"
  }
}
